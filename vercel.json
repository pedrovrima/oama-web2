{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "//": "Arquivos de public/ não levam hash no nome, então não podem ser 'immutable': se a imagem for trocada o caminho continua o mesmo. O CDN da Vercel é purgado a cada deploy; o TTL abaixo vale para o cache do navegador, com stale-while-revalidate para a visita seguinte não esperar a revalidação.",
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|gif|avif|ico|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "//": "Saída do build do Astro: nome já contém hash do conteúdo, logo pode ser cacheada para sempre.",
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/quem-somos", "destination": "/sobre", "statusCode": 301 },
    { "source": "/projetos", "destination": "/programas-e-projetos", "statusCode": 301 },
    { "source": "/jucara", "destination": "/programas-e-projetos/campanha-jacucara", "statusCode": 301 },
    { "source": "/treinamento-cursos", "destination": "/consultoria/cursos", "statusCode": 301 },
    { "source": "/treinamento-cursos/curso-foto", "destination": "/consultoria/cursos", "statusCode": 301 },
    { "source": "/anilhamento-demonstrativo", "destination": "/programas-e-projetos/monitoramento-de-avifauna", "statusCode": 301 },
    { "source": "/estacao-de-pesquisa", "destination": "/programas-e-projetos/monitoramento-de-avifauna", "statusCode": 301 },
    { "source": "/camci", "destination": "/programas-e-projetos/projetos-de-pesquisa", "statusCode": 301 },
    { "source": "/blog/old/:slug", "destination": "/blog/:slug", "statusCode": 301 },
    { "source": "/whatsapp", "destination": "https://api.whatsapp.com/send?phone=5524999627394", "statusCode": 301 }
  ]
}
