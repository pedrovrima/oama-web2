# Mapa das variáveis de ambiente deste projeto.
# Este arquivo É versionado e serve de referência — NUNCA coloque valor real aqui.
# Os valores ficam em `.env`, que é gitignored e nunca foi versionado.
#
# Para começar:  cp .env.example .env   e preencha o que precisar.

# --- Sanity (CMS) ------------------------------------------------------------
# Leitura: o site lê o dataset público, então build e dev funcionam sem token.
SANITY_PROJECT_ID=1tnejkhf
SANITY_DATASET=production
PUBLIC_SANITY_PROJECT_ID=1tnejkhf
PUBLIC_SANITY_DATASET=production

# Escrita: só necessário para scripts que CRIAM ou ALTERAM conteúdo no CMS
# (hoje: scripts/blog/importar-posts.mjs).
# Gerar em: sanity.io/manage -> projeto 1tnejkhf -> API -> Tokens -> permissão Editor.
# Dá poder de alterar o site em produção: não cole em issue, chat ou captura de tela.
SANITY_WRITE_TOKEN=

# --- Stripe ------------------------------------------------------------------
# Usado por scripts/fetch-apoie-stripe.mjs para gerar src/data/apoie-stripe.json.
# O build NÃO precisa desta chave: o snapshot já está commitado.
STRIPE_KEY=

# --- Newsletter / Fale Conosco ------------------------------------------------
# Endpoint do mailer próprio do OAMa (repo newsletter-oama). Se vazio, o site usa
# o padrão de produção definido em src/scripts/newsletter.ts.
PUBLIC_NEWSLETTER_ENDPOINT=

# Endpoint do formulário Fale Conosco (rota /api/contato do mesmo mailer).
# Se vazio, usa o padrão de produção definido em src/scripts/contato.ts.
PUBLIC_CONTATO_ENDPOINT=

# Chave PÚBLICA (site key) do Cloudflare Turnstile — anti-bot dos formulários.
# Gerar em: dash.cloudflare.com -> Turnstile. Se vazia, os formulários funcionam
# normalmente sem captcha (fail-open); a chave secreta fica só no mailer.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Site ---------------------------------------------------------------------
# Sobrescreve o domínio usado em canonical, Open Graph e sitemap.
# Padrão: https://oama.eco.br (definido em astro.config.mjs).
SITE_URL=
