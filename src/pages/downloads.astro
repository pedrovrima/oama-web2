<BaseLayout
  title="Arquivos e Downloads — OAMa"
  description="Cartilhas, pôsteres, banners, relatórios e trabalhos acadêmicos do OAMa para baixar de graça, ler, imprimir e compartilhar à vontade."
  image="/midias/realizacoes/downloads.jpg"
>
  <main class="font-montserrat text-[#1e1702]">
    <!-- HERO -->
    <section class="relative h-[380px] w-full overflow-hidden md:h-[460px]">
      <img
        src="/midias/realizacoes/downloads.jpg"
        alt="Materiais para download do OAMa"
        class="absolute inset-0 h-full w-full object-cover object-[50%_45%]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/35"></div>
      <div class="absolute inset-x-0 bottom-0 z-10 flex flex-col items-center px-6 pb-10 md:pb-14">
        <h1 class="text-center font-oswald text-[36px] font-bold uppercase leading-none text-white drop-shadow-md md:text-[58px]">
          Arquivos e Downloads
        </h1>
        <div class="mt-4 h-[6px] w-40 rounded-full bg-[#e9b130] md:w-64"></div>
      </div>
    </section>

    <!-- Introdução + atalhos para as seções -->
    <section class="bg-[#e9b130]">
      <div class="mx-auto max-w-5xl px-7 py-10 md:px-12 md:py-12">
        <p class="mx-auto max-w-3xl text-center text-[17px] leading-[27px] text-[#1e1702] md:text-[18px]">
          Todo o material produzido pelo OAMa está disponível aqui, de graça, para leitura,
          impressão e compartilhamento. Escolha uma categoria abaixo e baixe o que quiser.
        </p>
        <nav class="mt-7 flex flex-wrap items-center justify-center gap-3">
          {
            secoes.map((secao) => (
              <a
                href={`#${secao.id}`}
                class="rounded-full border-2 border-[#1e1702] bg-[#fbf5e6] px-5 py-2 font-montserrat text-[13px] font-extrabold uppercase tracking-[0.04em] text-[#1e1702] transition hover:bg-[#1e1702] hover:text-[#fbf5e6]"
              >
                {secao.titulo}
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    {
      secoes.map((secao) => (
        <section id={secao.id} class="scroll-mt-24" style={`background: ${secao.fundo};`}>
          <div class="mx-auto max-w-6xl px-7 py-14 md:px-12 md:py-20">
            <h2
              class="text-center font-oswald text-[30px] font-bold uppercase leading-tight md:text-[44px]"
              style={`color: ${secao.corTexto};`}
            >
              {secao.titulo}
            </h2>
            <p
              class="mx-auto mt-3 max-w-2xl text-center text-[16px] leading-[26px] md:text-[17px]"
              style={`color: ${secao.corTexto};`}
            >
              {secao.descricao}
            </p>

            <div class="mt-10 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
              {secao.itens.map((item) => (
                <a
                  href={urlDoItem(item)}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics-event="content_download_click"
                  data-analytics-label={item.titulo}
                  data-analytics-location="downloads_grid"
                  class="group flex h-full flex-col overflow-hidden rounded-[20px] bg-white shadow-md transition hover:-translate-y-1 hover:shadow-xl focus:outline-none focus-visible:ring-4 focus-visible:ring-[#1a2e4a]"
                >
                  <img
                    src={urlDaImagem(item)}
                    alt={item.titulo}
                    class="h-[210px] w-full bg-[#fbf5e6] object-contain"
                    loading="lazy"
                  />
                  <div class="flex flex-1 flex-col px-6 py-5">
                    <h3 class="font-montserrat text-[17px] font-extrabold leading-[24px] text-[#111111]">
                      {item.titulo}
                    </h3>
                    <p class="mt-3 text-[15px] leading-[24px] text-[#333333]">{item.texto}</p>
                    <span class="mt-5 inline-flex items-center gap-2 font-montserrat text-[13px] font-extrabold uppercase tracking-[0.04em] text-[#1a2e4a]">
                      {item.linkExterno ? "Assistir" : "Baixar arquivo"}
                      <span aria-hidden="true" class="transition group-hover:translate-x-1">
                        &rarr;
                      </span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <WaveDark
      topColor="#fbf5e6"
      bottomColor="#5ba4d9"
      path1Color="#1e1702"
      path2Color="#fbf5e6"
    />
  </main>
</BaseLayout>
