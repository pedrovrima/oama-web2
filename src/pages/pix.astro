---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveDark from "../components/sections/WaveDark.astro";

// Origem: legado `pages/pix.js` (payload/QR) e `pages/__apoie__/index.js` (dados bancários).
const payloadPix =
  "00020126360014BR.GOV.BCB.PIX0114357135120001805204000053039865802BR5923OAMa - Aves Mantiqueira6011Resende- RJ62140510DOACAOOAMA63046E50";

const dadosBancarios = [
  { rotulo: "Banco", valor: "Banco do Brasil" },
  { rotulo: "Código", valor: "001" },
  { rotulo: "Agência", valor: "0131-7" },
  { rotulo: "Conta corrente", valor: "81487-3" },
  { rotulo: "CNPJ", valor: "35.713.512/0001-80" },
];
---

<BaseLayout title="PIX — OAMa">
  <main class="font-montserrat text-[#1e1702]">
    <section class="relative overflow-hidden bg-[#1a2e4a]">
      <div class="absolute inset-0 opacity-20">
        <img
          src="/apoie/apoie.jpg"
          alt=""
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
      <div class="relative mx-auto flex min-h-[520px] max-w-5xl flex-col justify-end px-6 pb-16 pt-32 md:min-h-[600px] md:px-10">
        <span class="mb-4 inline-flex w-fit rounded-full bg-[#EDC15A] px-5 py-2 text-xs font-extrabold uppercase tracking-[0.18em] text-[#1a2e4a]">
          Doação única
        </span>
        <h1 class="max-w-3xl font-oswald text-[42px] font-extrabold uppercase leading-none text-white md:text-[72px]">
          Doação via PIX
        </h1>
        <p class="mt-5 max-w-2xl text-[18px] leading-[29px] text-white/90 md:text-[22px] md:leading-[34px]">
          Sua contribuição ajuda o OAMa a transformar apoio em pesquisa,
          conhecimento, educação ambiental e conservação das aves da Mata Atlântica.
        </p>
      </div>
    </section>

    <WaveDark
      topColor="#1a2e4a"
      bottomColor="#dfb553"
      path1Color="#1e1702"
      path2Color="#fbf5e6"
    />

    <section class="bg-[#dfb553] px-6 py-14 md:px-10 md:py-20">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-[1.05fr_0.95fr] md:items-start">
        <div class="rounded-[28px] bg-white p-7 shadow-xl md:p-10">
          <h2 class="font-oswald text-[30px] font-extrabold uppercase leading-none text-[#1a2e4a] md:text-[42px]">
            Dados confirmados
          </h2>
          <p class="mt-4 text-[16px] leading-[26px] text-[#1e1702]/80">
            Estes são os dados bancários já migrados da página antiga do OAMa e
            usados na página <a href="/apoie" class="font-bold text-[#1a2e4a] underline decoration-[#EDC15A] decoration-2 underline-offset-4">Apoie</a>.
          </p>

          <dl class="mt-8 divide-y divide-[#1a2e4a]/10 rounded-2xl border border-[#1a2e4a]/10 bg-[#fbf5e6]">
            {
              dadosBancarios.map((item) => (
                <div class="grid gap-1 px-5 py-4 sm:grid-cols-[160px_1fr] sm:gap-4">
                  <dt class="text-sm font-bold uppercase tracking-[0.12em] text-[#1a2e4a]/65">
                    {item.rotulo}
                  </dt>
                  <dd class="text-[18px] font-extrabold text-[#1a2e4a]">
                    {item.valor}
                  </dd>
                </div>
              ))
            }
          </dl>

          <div class="mt-7 rounded-2xl bg-[#1a2e4a] p-5 text-white">
            <p class="text-[15px] leading-[24px]">
              Use os dados bancários acima para transferência ou faça a doação
              pelo QR code e pelo PIX copia e cola ao lado.
            </p>
          </div>
        </div>

        <aside class="rounded-[28px] bg-[#5ba4d9] p-7 text-white shadow-xl md:p-10">
          <h2 class="font-oswald text-[30px] font-extrabold uppercase leading-none md:text-[40px]">
            Pague com PIX
          </h2>
          <p class="mt-4 text-[16px] leading-[26px] text-white/90">
            Aponte a câmera do seu aplicativo bancário para o QR code ou use o
            PIX copia e cola.
          </p>

          <img
            src="/pix/qrcode-donation-oama.png"
            alt="QR code para doação via PIX ao OAMa"
            class="mx-auto mt-7 w-full max-w-[280px] rounded-2xl bg-white p-3"
            loading="eager"
          />

          <div class="mt-7 rounded-2xl bg-white p-4 text-[#1a2e4a]">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#1a2e4a]/60">
              PIX copia e cola
            </p>
            <code class="mt-3 block break-all text-xs leading-5">{payloadPix}</code>
            <button
              id="copiar-pix"
              type="button"
              data-payload={payloadPix}
              class="mt-4 w-full rounded-full bg-[#1a2e4a] px-5 py-3 text-sm font-extrabold uppercase tracking-[0.08em] text-white transition hover:bg-[#EDC15A] hover:text-[#1a2e4a]"
            >
              Copiar código PIX
            </button>
            <p id="status-copia-pix" class="mt-3 text-sm font-semibold" role="status" aria-live="polite"></p>
          </div>

          <a
            href="/apoie"
            class="mt-8 inline-flex rounded-full bg-[#EDC15A] px-7 py-3 font-extrabold uppercase text-[#1a2e4a] transition hover:bg-white"
          >
            Ver outras formas de apoiar
          </a>
        </aside>
      </div>
    </section>

    <WaveDark
      topColor="#dfb553"
      bottomColor="#5ba4d9"
      path1Color="#1e1702"
      path2Color="#fbf5e6"
    />
  </main>

  <script>
    const botao = document.querySelector<HTMLButtonElement>("#copiar-pix");
    const status = document.querySelector<HTMLElement>("#status-copia-pix");
    const rotuloOriginal = botao?.textContent?.trim() ?? "Copiar código PIX";
    let timer: ReturnType<typeof setTimeout> | undefined;

    function restaurarBotao() {
      if (botao) botao.textContent = rotuloOriginal;
    }

    botao?.addEventListener("click", async () => {
      clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(botao.dataset.payload ?? "");
        botao.textContent = "Código copiado!";
        if (status) {
          status.textContent = "Código PIX copiado para a área de transferência.";
          status.classList.remove("text-red-700");
          status.classList.add("text-green-700");
        }
        timer = setTimeout(restaurarBotao, 3000);
      } catch {
        if (status) {
          status.textContent = "Não foi possível copiar o código. Selecione-o acima.";
          status.classList.remove("text-green-700");
          status.classList.add("text-red-700");
        }
      }
    });
  </script>
</BaseLayout>
