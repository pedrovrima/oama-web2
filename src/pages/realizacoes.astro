---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveDark from "../components/sections/WaveDark.astro";

const realizacoes = [
  {
    id: "downloads",
    titulo: "Downloads",
    descricao: "Baixe livros, cartilhas, pôsteres ilustrados, adesivos anti colisão e muito mais",
    imagem: "/midias/realizacoes/downloads.webp",
    alt: "Material para download do OAMa",
    href: "/downloads",
  },
  {
    id: "documentarios",
    titulo: "Documentários",
    descricao: "Assista às produções audiovisuais do OAMa",
    imagem: "/midias/realizacoes/documentarios.webp",
    alt: "Documentários do OAMa",
    href: "https://www.youtube.com/channel/UCzLcpYmPb1DR524wXb0CvHA",
  },
  {
    id: "wikimudas",
    titulo: "Wikimudas",
    descricao: "Conheça nossa enciclopédia colaborativa de muda e idade de aves brasileiras",
    imagem: "/midias/realizacoes/wikimudas.webp",
    alt: "Wikimudas — enciclopédia de muda e idade de aves brasileiras",
    href: "https://wikimudas.oama.eco.br",
  },
  {
    id: "webapp-xara",
    titulo: "Webapp Xará",
    descricao: "Dicionário colaborativo de nomes populares de aves brasileiras",
    // Capa: a propria busca do Xara. Nao ha foto que comunique um dicionario de
    // nomes, e a interface identifica o produto sem improvisar imagem.
    imagem: "/midias/realizacoes/webapp-xara.webp",
    alt: "Busca do Xará mostrando nomes populares de sabiás e seus nomes científicos",
    href: "https://xara.oama.eco.br",
  },
  {
    id: "webapp-colisoes",
    titulo: "Webapp Colisões com Vidros",
    descricao: "Reporte colisões de aves e contribua com a ciência cidadã",
    // Capa: a ilustracao de abertura do proprio webapp, assinada pelo OAMa e
    // pelo Acoes Pro-Aves.
    imagem: "/midias/realizacoes/webapp-colisoes.webp",
    alt: "Ilustração de ave colidindo contra uma vidraça, abertura do webapp de reportes",
    href: "https://colisoes.oama.eco.br",
  },
  {
    id: "divulgacao-cientifica",
    titulo: "Divulgação Científica",
    descricao: "Um blog para compartilhar e aproximar a ciência de você",
    imagem: "/midias/realizacoes/divulgacao-cientifica.webp",
    alt: "Divulgação científica do OAMa",
    // Blog migrado do site antigo para este repo (rota interna /blog).
    href: "/blog",
  },
  {
    id: "textos-academicos",
    titulo: "Textos Acadêmicos",
    descricao: "Leia artigos e resumos científicos de pesquisas lideradas pela equipe OAMa",
    imagem: "/midias/realizacoes/textos-academicos.webp",
    alt: "Textos acadêmicos e artigos científicos do OAMa",
    href: "/downloads#academico",
  },
];
---

<BaseLayout
  title="Realizações — OAMa"
  description="Downloads, documentários, a enciclopédia Wikimudas, os webapps Xará e de reportes de colisões, o blog de divulgação científica e os textos acadêmicos do OAMa."
  image="/midias/realizacoes/capa-realizacoes.webp"
>
  <main class="font-montserrat text-[#1e1702]">
    {/* HERO — enquadramento mais aberto, como no frame do Figma (2581:454):
        a ave e o galho aparecem inteiros. Com object-cover a 1440px a foto
        (3:2) rende 960px de altura, então manter a seção em 720px e deslocar
        o object-position para 35% mostra a ave da cabeça à cauda sem corte. */}
    <section class="relative h-[520px] w-full overflow-hidden md:h-[720px]">
      <img
        srcset="/midias/realizacoes/capa-realizacoes-640w.webp 640w, /midias/realizacoes/capa-realizacoes-960w.webp 960w, /midias/realizacoes/capa-realizacoes-1280w.webp 1280w, /midias/realizacoes/capa-realizacoes.webp 1920w"
        sizes="100vw"
        src="/midias/realizacoes/capa-realizacoes.webp"
        alt="Realizações do OAMa"
        class="absolute inset-0 h-full w-full object-cover object-[50%_35%]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/10"></div>
      <div class="absolute inset-x-0 bottom-0 z-10 flex justify-center px-6 pb-8 md:pb-18">
        <h1 class="text-center font-oswald text-[36px] font-bold uppercase leading-none text-white drop-shadow-md md:text-[58px]">
          Realizações
        </h1>
      </div>
    </section>

    <section class="bg-[#dfb553]">
      <div class="mx-auto max-w-5xl px-7 py-12 md:px-12 md:py-16">
        {/* Parágrafo de abertura do documento oficial de redação do cliente (verbatim). */}
        <p class="mx-auto mb-10 max-w-[760px] text-center text-[18px] leading-[27px] text-[#1e1702] md:mb-12">
          Esta é uma central onde você encontrará todas as produções de divulgação científica,
          pesquisa e comunicação institucional do Observatório de Aves da Mantiqueira. Clique na
          categoria que deseja explorar e aproveite.
        </p>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-x-10 md:gap-y-12">
          {
            realizacoes.map((item) => (
              <article
                id={item.id}
                class="relative overflow-hidden rounded-[24px] bg-white shadow-sm scroll-mt-24"
              >
                <img
                  src={item.imagem}
                  alt={item.alt}
                  class="h-[245px] w-full object-cover md:h-[300px]"
                  loading="lazy"
                  decoding="async"
                />

                <div class="flex min-h-[132px] flex-col items-center justify-center px-6 py-6 text-center md:min-h-[150px]">
                  <h2 class="font-montserrat text-[18px] font-extrabold uppercase leading-[24px] tracking-[0.01em] text-[#111111]">
                    {item.titulo}
                  </h2>
                  <p class="mt-2 max-w-[340px] text-[18px] leading-[27px] text-[#111111] md:text-[18px] md:leading-[27px]">
                    {item.descricao}
                  </p>
                </div>

                {
                  item.href && (
                    <a
                      href={item.href}
                      target={item.href.startsWith("/") ? undefined : "_blank"}
                      rel={item.href.startsWith("/") ? undefined : "noopener noreferrer"}
                      aria-label={`Abrir ${item.titulo}`}
                      class="absolute inset-0 z-10 rounded-[24px] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#1a2e4a] focus-visible:ring-inset"
                    >
                      <span class="sr-only">Abrir {item.titulo}</span>
                    </a>
                  )
                }
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <WaveDark
      topColor="#dfb553"
      bottomColor="#5ba4d9"
      path1Color="#1e1702"
      path2Color="#fbf5e6"
    />
  </main>
</BaseLayout>
