  {
    estado: "Minas Gerais",
    locais: [
      {
        nome: "Parque Estadual do Rio Doce",
        site: "https://www.sei.mg.gov.br/sei/controlador_externo.php?acao=usuario_externo_avisar_cadastro&id_orgao_acesso_externo=0&CSRF_TOKEN=cfdd0939cf8f5a2dd3144b507599055cda7e70c5",
