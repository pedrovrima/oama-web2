    {/* ================= MATERIAIS RELACIONADOS ================= */}
    <section id="materiais" class="scroll-mt-24 bg-oama-cream px-6 py-14">
      <div class="mx-auto max-w-5xl">
        <h2 class="font-oswald text-[28px] font-bold uppercase leading-tight md:text-[36px]">
          Materiais Relacionados
        </h2>
        <div class="mt-2 h-1 w-24 rounded-full bg-oama-yellow"></div>

        <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
          {materiais.map((material) => (
            <li>
              <a
                href={material.site}
                target={material.interno ? undefined : "_blank"}
                rel={material.interno ? undefined : "noopener noreferrer"}
                class="block overflow-hidden rounded-md bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-oama-ink"
              >
                <img
                  src={`/jacucara/pags/${material.arquivo}`}
                  alt={material.alt}
                  class="h-auto w-full"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Encerramento — fig 11 (créditos da campanha) */}
    <section class="w-full" style={`background:${roxo};`}>
      <img
        src="/jacucara/figs/11.webp"
        alt="Crédito da campanha: “A Campanha Jacuçara é uma iniciativa do PAN Aves Mata Atlântica”, organizada por OAMa, CNCFlora, Jardim Botânico do Rio de Janeiro, AZAB, Aves Argentinas, Parque das Aves, SAVE Brasil, Parque Nacional do Iguaçu, CEMAVE e ICMBio"
        class="h-auto w-full"
        loading="lazy"
        decoding="async"
      />
    </section>

    <WaveDark topColor={roxo} bottomColor={azul} path1Color="#dfb553" path2Color="#1e1702" />
  </main>
</BaseLayout>
