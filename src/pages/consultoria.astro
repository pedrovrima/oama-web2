---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveDark from "../components/sections/WaveDark.astro";

const frentes = [
  {
    href: "/consultoria/monitoramento-de-aves",
    titulo: "Monitoramento de Aves e Estudos de Avifauna",
    imagem: "/midias/consultoria/monitoramento.jpg",
    alt: "Ave sendo medida em atividade técnica de monitoramento",
  },
  {
    href: "/consultoria/educacao-ambiental",
    titulo: "Educação Ambiental e Comunicação Científica",
    imagem: "/midias/consultoria/educacao.jpg",
    alt: "Grupo em atividade externa de educação ambiental",
  },
  {
    href: "/consultoria/capacitacao-tecnica",
    titulo: "Capacitação Técnica e Formação Profissional em Ornitologia",
    imagem: "/midias/consultoria/capacitacao.jpg",
    alt: "Pessoa em atividade de capacitação técnica com ave em mãos",
  },
];

// Copy extraída dos nós do Figma do frame Desktop_CONSULTORIA (I2616:*, I2593:*).
// A copy anterior era uma reescrita que não correspondia ao design.
const diferenciais = [
  "Recursos revertidos em projetos de pesquisa, conservação e sensibilização ambiental",
  "Equipe qualificada para a coleta de dados padronizados em ornitologia",
  "Corpo técnico pautado na ética, respeito e diversidade",
  "Foco no bem estar animal",
  "Transposição didática da ciência para todas as idades",
  "Design original e personalizado de materiais gráficos e de atividades didáticas",
  "Práticas que integram a arte ao conhecimento científico e à educação",
  "Instrutores habilitados e certificados nacional e internacionalmente",
  "Sistema padronizado de ensino-aprendizagem",
  "Formação baseada em atividades práticas supervisionadas",
];

// Categorias de clientes conforme os nós I2594:813 e I2619:* do Figma.
const clientes = [
  "Empresas e consultorias ambientais",
  "Empreendimentos de impacto ambiental",
  "Órgãos públicos e administração pública",
  "Universidades e institutos de pesquisa",
  "Estudantes e profissionais da área ambiental",
  "Escolas e museus",
  "Organizações da sociedade civil",
  "Unidades de conservação",
  "Observadores de aves e da natureza",
];


// Renderizados como texto: não há arquivo de logo destas instituições nas mídias do cliente.
const logos = [
  "AGEVAP - Associação Pró-gestão das Águas da Bacia Hidrográfica do Rio Paraíba do Sul",
  "Casa Tlalli",
  "Scinax Consultoria Ambiental",
  "The Nature Conservancy",
];
---

<BaseLayout
  description="Serviços técnicos do OAMa em monitoramento de aves, educação ambiental, comunicação científica e formação profissional, com foco na Mata Atlântica."
  image="/midias/consultoria/capa-consultoria.jpg" title="Consultoria — OAMa" navVariant="overlay">
  <main class="font-montserrat bg-[#201700]">
    {/* HERO (frame: foto de altura contida, SEM título sobreposto) */}
    <section class="relative h-[300px] w-full overflow-hidden md:h-[620px]">
      <img
        src="/midias/consultoria/capa-consultoria.jpg"
        alt="Capa da seção de consultoria do OAMa"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
    </section>

    <section class="bg-[#5ba4d9] px-6 py-12 text-white md:px-8 md:py-14">
      <div class="mx-auto max-w-5xl text-center">
        <h1
          class="mb-10 text-center font-oswald text-[30px] font-bold uppercase leading-[36px] text-white md:text-[42px] md:leading-[48px]"
        >
          Consultoria
        </h1>

        <h2 class="font-oswald text-[24px] font-bold uppercase leading-[1.05] md:text-[34px]">
          Serviços baseados em ciência e conservação
        </h2>
        <p class="mt-2 text-[15px] leading-6 md:text-[18px] md:leading-7">
          Juntos, multiplicando e potencializando impactos socioambientais reais.
        </p>
        <div class="mx-auto mt-6 max-w-4xl space-y-4 text-[15px] leading-6 md:text-[17px] md:leading-7">
          {/* Texto oficial do documento de redação do cliente, aplicado verbatim.
              Correção de digitação: o documento escreve "em mais de seteis anos".
              O OAMa foi fundado em 2019, logo em 2026 são sete anos — usamos "sete". */}
          <p>
            Além de promover a confluência entre ciência, conservação e a sociedade brasileira,
            o OAMa também oferece serviços técnicos para terceiros nas áreas de 1. monitoramento
            de aves e estudos de avifauna, 2. educação ambiental e comunicação científica e
            3. capacitação técnica e formação profissional em ornitologia
          </p>
          <p>
            Em mais de sete anos de atuação, o OAMa acumulou preciosas experiências, seja em
            campo, coletando dados que fomentam estudos técnicos sobre impactos ambientais na
            conservação e treinando uma nova geração de pesquisadores, ou em escolas e espaços
            não-formais de educação divulgando a ciência por meio de linguagem acessível a
            públicos diversos.
          </p>
          <p>
            O compromisso do OAMa é com a ética e a excelência profissional, e com o envolvimento
            e a democratização do saber científico para com as pessoas. Tudo convergindo para a
            aplicação de técnicas e metodologias padronizadas. Gerando, assim,
            <strong>
              conhecimento científico capaz de fomentar soluções para os desafios atuais da
              conservação da biodiversidade e o enfrentamento das mudanças climáticas globais,
              com foco especial na Mata Atlântica do sudeste brasileiro.
            </strong>
          </p>
        </div>

        <h3 class="mt-10 font-oswald text-[24px] font-bold uppercase md:text-[30px]">
          Frentes de atuação
        </h3>
        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            frentes.map((frente) => (
              <a
                href={frente.href}
                class="group relative overflow-hidden rounded-[20px] shadow-[0_10px_30px_rgba(0,0,0,0.18)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(0,0,0,0.24)]"
              >
                <div class="relative aspect-[0.95/1]">
                  <img
                    src={frente.imagem}
                    alt={frente.alt}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
                  <div class="absolute inset-x-0 bottom-0 px-4 pb-5 pt-12 text-left text-white">
                    <p class="font-oswald text-[22px] uppercase leading-[1.02] md:text-[24px]">
                      {frente.titulo}
                    </p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-white px-6 py-12 md:px-8 md:py-14">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-center font-oswald text-[26px] font-bold uppercase text-oama-ink md:text-[34px]">
          Por que escolher o OAMa?
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {
            diferenciais.map((item, index) => (
              <div class={`rounded-[12px] px-5 py-6 text-center text-[15px] leading-6 md:text-[16px] md:leading-7 font-medium ${index % 2 === 0 ? 'bg-oama-yellow text-oama-ink' : 'bg-oama-blue text-white'}`}>
                  <span>{item}</span>
              </div>
            ))
          }
        </div>

        <h2 class="mt-12 text-center font-oswald text-[26px] font-bold uppercase text-oama-ink md:text-[34px]">
          Clientes
        </h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            clientes.map((cliente) => (
              <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-oama-blue">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M9 12h.01M9 15h.01M15 9h.01M15 12h.01M15 15h.01" />
                  </svg>
                </div>
                <p class="text-[15px] leading-6 font-medium text-oama-ink">{cliente}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            logos.map((logo) => (
              <div class="flex items-center justify-center rounded-[18px] border border-oama-ink/10 bg-white px-6 py-5 text-center shadow-sm">
                <p class="font-oswald text-[18px] uppercase leading-tight tracking-wide text-oama-ink md:text-[20px]">
                  {logo}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <WaveDark topColor="#ffffff" bottomColor="#5ba4d9" path1Color="#dfb553" path2Color="#201700" />

    <section class="bg-[#5ba4d9] px-6 py-12 text-white md:px-8 md:py-14">
      <div class="mx-auto max-w-4xl">
        <h2 class="font-oswald text-[28px] font-bold uppercase md:text-[34px]">Fale conosco</h2>
        <p class="mt-3 max-w-3xl text-[15px] leading-6 md:text-[17px] md:leading-7">
          Precisa de apoio técnico, uma proposta de serviço ou quer construir uma parceria com o OAMa?
          Preencha o formulário ou escreva para <a href="mailto:contato@oama.eco.br" class="underline underline-offset-4">contato@oama.eco.br</a>.
        </p>

        <form class="mt-8 space-y-3" aria-label="Fale conosco" data-contato-form data-contato-origem="Consultoria (hub)">
          {/* Honeypot anti-spam: humanos não veem; bots preenchem e o servidor descarta. */}
          <div class="hidden" aria-hidden="true">
            <label for="consultoria-website">Não preencha este campo</label>
            <input id="consultoria-website" type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <label class="sr-only" for="consultoria-nome">Seu nome</label>
          <input
            id="consultoria-nome"
            type="text"
            name="nome"
            placeholder="Seu nome"
            autocomplete="name"
            required
            class="w-full rounded-full bg-oama-yellow px-5 py-3 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          />
          <label class="sr-only" for="consultoria-cargo">Cargo ou organização</label>
          <input
            id="consultoria-cargo"
            type="text"
            name="cargo"
            placeholder="Cargo / organização"
            autocomplete="organization-title"
            class="w-full rounded-full bg-oama-yellow px-5 py-3 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          />
          <label class="sr-only" for="consultoria-email">Seu e-mail</label>
          <input
            id="consultoria-email"
            type="email"
            name="email"
            placeholder="Seu e-mail"
            autocomplete="email"
            required
            class="w-full rounded-full bg-oama-yellow px-5 py-3 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          />
          <label class="sr-only" for="consultoria-telefone">Seu telefone</label>
          <input
            id="consultoria-telefone"
            type="tel"
            name="telefone"
            placeholder="Seu telefone"
            autocomplete="tel"
            class="w-full rounded-full bg-oama-yellow px-5 py-3 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          />
          <label class="sr-only" for="consultoria-mensagem">Descreva sua necessidade</label>
          <textarea
            id="consultoria-mensagem"
            name="mensagem"
            placeholder="Descreva sua necessidade"
            rows="6"
            required
            class="w-full rounded-[24px] bg-oama-yellow px-5 py-4 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          ></textarea>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3 text-[15px] font-semibold text-[#5ba4d9] transition hover:brightness-95"
            >
              Enviar
            </button>
          </div>
          <p class="text-[14px] leading-5 text-white/90" data-contato-status hidden aria-live="polite"></p>
          <a
            class="inline-flex text-[14px] font-semibold text-white underline underline-offset-4"
            data-contato-fallback
            href="mailto:contato@oama.eco.br"
            hidden
          >
            Enviar por e-mail
          </a>
        </form>
      </div>
    </section>

    <WaveDark topColor="#5ba4d9" bottomColor="#fbf5e6" path1Color="#ffffff" path2Color="#dfb553" />
  </main>
</BaseLayout>

<script>
  import { wireContatoForms } from "../scripts/contato";
  wireContatoForms();
</script>
