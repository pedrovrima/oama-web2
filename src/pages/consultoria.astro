---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveDark from "../components/sections/WaveDark.astro";

const frentes = [
  {
    href: "/consultoria/monitoramento-de-aves",
    titulo: "Monitoramento de Aves e Estudos de Avifauna",
    imagem: "/midias/consultoria/monitoramento.jpg",
    alt: "Ave sendo medida em atividade técnica de monitoramento",
  },
  {
    href: "/consultoria/educacao-ambiental",
    titulo: "Educação Ambiental e Comunicação Científica",
    imagem: "/midias/consultoria/educacao.jpg",
    alt: "Grupo em atividade externa de educação ambiental",
  },
  {
    href: "/consultoria/capacitacao-tecnica",
    titulo: "Capacitação Técnica e Formação Profissional em Ornitologia",
    imagem: "/midias/consultoria/capacitacao.jpg",
    alt: "Pessoa em atividade de capacitação técnica com ave em mãos",
  },
];

const diferenciais = [
  "Atuação guiada por ciência aplicada e conservação.",
  "Equipe qualificada para planejamento, campo, análise e comunicação.",
  "Corpo técnico com experiência em avifauna e Mata Atlântica.",
  "Foco no bem-estar animal e na ética profissional.",
  "Transposição didática da ciência para diferentes públicos.",
  "Planejamento de atividades formais e não-formais de educação.",
  "Integração entre pesquisa, monitoramento e formação.",
  "Parcerias técnicas e institucionais em diferentes escalas.",
  "Serviços personalizados para cada contexto socioambiental.",
  "Formação baseada em atividades práticas supervisionadas.",
];

const clientes = [
  "Empresas e consultorias socioambientais",
  "Empreendimentos e instituições privadas",
  "Órgãos públicos e administrações locais",
  "Universidades e institutos de pesquisa",
  "Redes de ensino e espaços educativos",
  "Projetos e movimentos sociais",
  "Organizações da sociedade civil",
  "Iniciativas de restauração e conservação",
  "Observadores de aves e turismo de natureza",
];

const logos = ["AGEVAP", "Casa Tlalli"];
---

<BaseLayout title="Consultoria — OAMa" navVariant="overlay">
  <main class="font-montserrat bg-[#201700]">
    <section class="relative min-h-[85vh] w-full overflow-hidden">
      <img
        src="/midias/consultoria/capa-consultoria.jpg"
        alt="Capa da seção de consultoria do OAMa"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/30"></div>

      <div class="absolute inset-0 z-10 flex items-end justify-center px-6 pb-8 text-center md:pb-14">
        <h1 class="font-oswald text-[40px] font-bold uppercase leading-[0.95] text-white md:text-[68px]">
          Consultoria
        </h1>
      </div>
    </section>

    <section class="bg-[#5ba4d9] px-6 py-12 text-white md:px-8 md:py-14">
      <div class="mx-auto max-w-5xl text-center">
        <h2 class="font-oswald text-[24px] font-bold uppercase leading-[1.05] md:text-[34px]">
          Serviços baseados em ciência e conservação
        </h2>
        <p class="mt-2 text-[15px] leading-6 md:text-[18px] md:leading-7">
          Juntos, multiplicando e potencializando impactos socioambientais reais.
        </p>
        <div class="mx-auto mt-6 max-w-4xl space-y-4 text-[15px] leading-6 md:text-[17px] md:leading-7">
          <p>
            Além de promover a confluência entre ciência, conservação e sociedade, o OAMa
            oferece serviços técnicos para parceiros, instituições, projetos e territórios
            que precisam de soluções com base em dados, método e sensibilidade socioambiental.
          </p>
          <p>
            Nosso trabalho combina monitoramento de aves, educação ambiental, comunicação
            científica e formação profissional, sempre com foco na Mata Atlântica e na qualidade
            técnica das entregas.
          </p>
        </div>

        <h3 class="mt-10 font-oswald text-[24px] font-bold uppercase md:text-[30px]">
          Frentes de atuação
        </h3>
        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            frentes.map((frente) => (
              <a
                href={frente.href}
                class="group relative overflow-hidden rounded-[20px] shadow-[0_10px_30px_rgba(0,0,0,0.18)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(0,0,0,0.24)]"
              >
                <div class="relative aspect-[0.95/1]">
                  <img
                    src={frente.imagem}
                    alt={frente.alt}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
                  <div class="absolute inset-x-0 bottom-0 px-4 pb-5 pt-12 text-left text-white">
                    <p class="font-oswald text-[22px] uppercase leading-[1.02] md:text-[24px]">
                      {frente.titulo}
                    </p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-white px-6 py-12 md:px-8 md:py-14">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-center font-oswald text-[26px] font-bold uppercase text-oama-ink md:text-[34px]">
          Por que escolher o OAMa?
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {
            diferenciais.map((item, index) => (
              <div class={`rounded-[12px] px-5 py-6 text-center text-[15px] leading-6 md:text-[16px] md:leading-7 font-medium ${index % 2 === 0 ? 'bg-oama-yellow text-oama-ink' : 'bg-oama-blue text-white'}`}>
                <div class="flex items-start gap-3">
                  <svg class="mt-0.5 h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <span>{item}</span>
                </div>
              </div>
            ))
          }
        </div>

        <h2 class="mt-12 text-center font-oswald text-[26px] font-bold uppercase text-oama-ink md:text-[34px]">
          Clientes
        </h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            clientes.map((cliente) => (
              <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-oama-blue">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M9 12h.01M9 15h.01M15 9h.01M15 12h.01M15 15h.01" />
                  </svg>
                </div>
                <p class="text-[15px] leading-6 font-medium text-oama-ink">{cliente}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-10 flex flex-col items-center gap-4 md:flex-row md:justify-center">
          {
            logos.map((logo) => (
              <div class="min-w-[220px] rounded-[18px] border border-oama-ink/10 bg-white px-8 py-5 text-center shadow-sm">
                <p class="font-oswald text-[26px] uppercase tracking-wide text-oama-ink">{logo}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <WaveDark topColor="#ffffff" bottomColor="#5ba4d9" path1Color="#dfb553" path2Color="#201700" />

    <section class="bg-[#5ba4d9] px-6 py-12 text-white md:px-8 md:py-14">
      <div class="mx-auto max-w-4xl">
        <h2 class="font-oswald text-[28px] font-bold uppercase md:text-[34px]">Fale conosco</h2>
        <p class="mt-3 max-w-3xl text-[15px] leading-6 md:text-[17px] md:leading-7">
          Precisa de apoio técnico, uma proposta de serviço ou quer construir uma parceria com o OAMa?
          Preencha o formulário ou escreva para <a href="mailto:contato@oama.eco.br" class="underline underline-offset-4">contato@oama.eco.br</a>.
        </p>

        <form class="mt-8 space-y-3" aria-label="Fale conosco" data-consultoria-form>
          <label class="sr-only" for="consultoria-nome">Seu nome</label>
          <input
            id="consultoria-nome"
            type="text"
            name="nome"
            placeholder="Seu nome"
            autocomplete="name"
            required
            class="w-full rounded-full bg-oama-yellow px-5 py-3 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          />
          <label class="sr-only" for="consultoria-cargo">Cargo ou organização</label>
          <input
            id="consultoria-cargo"
            type="text"
            name="cargo"
            placeholder="Cargo / organização"
            autocomplete="organization-title"
            class="w-full rounded-full bg-oama-yellow px-5 py-3 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          />
          <label class="sr-only" for="consultoria-email">Seu e-mail</label>
          <input
            id="consultoria-email"
            type="email"
            name="email"
            placeholder="Seu e-mail"
            autocomplete="email"
            required
            class="w-full rounded-full bg-oama-yellow px-5 py-3 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          />
          <label class="sr-only" for="consultoria-telefone">Seu telefone</label>
          <input
            id="consultoria-telefone"
            type="tel"
            name="telefone"
            placeholder="Seu telefone"
            autocomplete="tel"
            class="w-full rounded-full bg-oama-yellow px-5 py-3 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          />
          <label class="sr-only" for="consultoria-mensagem">Descreva sua necessidade</label>
          <textarea
            id="consultoria-mensagem"
            name="mensagem"
            placeholder="Descreva sua necessidade"
            rows="6"
            required
            class="w-full rounded-[24px] bg-oama-yellow px-5 py-4 text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none"
          ></textarea>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3 text-[15px] font-semibold text-[#5ba4d9] transition hover:brightness-95"
            >
              Preparar e-mail
            </button>
          </div>
          <p class="text-[14px] leading-5 text-white/90" data-consultoria-status hidden aria-live="polite"></p>
          <a
            class="inline-flex text-[14px] font-semibold text-white underline underline-offset-4"
            data-consultoria-email-link
            href="mailto:contato@oama.eco.br"
            hidden
          >
            Abrir o e-mail novamente
          </a>
        </form>
      </div>
    </section>

    <WaveDark topColor="#5ba4d9" bottomColor="#fbf5e6" path1Color="#ffffff" path2Color="#dfb553" />
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-consultoria-form]");
  const status = form?.querySelector<HTMLElement>("[data-consultoria-status]");
  const emailLink = form?.querySelector<HTMLAnchorElement>("[data-consultoria-email-link]");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const valor = (campo: string) => String(data.get(campo) ?? "").trim();
    const corpo = [
      "Olá, equipe OAMa!",
      "",
      "Gostaria de conversar sobre uma proposta de consultoria.",
      "",
      `Nome: ${valor("nome")}`,
      `Cargo / organização: ${valor("cargo") || "Não informado"}`,
      `E-mail: ${valor("email")}`,
      `Telefone: ${valor("telefone") || "Não informado"}`,
      "",
      "Necessidade:",
      valor("mensagem"),
    ].join("\n");
    const mailto = `mailto:contato@oama.eco.br?subject=${encodeURIComponent("Solicitação de consultoria pelo site")}&body=${encodeURIComponent(corpo)}`;

    if (emailLink && status) {
      emailLink.href = mailto;
      emailLink.hidden = false;
      status.textContent = "Seu aplicativo de e-mail será aberto com a mensagem preenchida. Revise os dados e confirme o envio por lá. Se nada acontecer, use o link abaixo.";
      status.hidden = false;
    }

    window.location.href = mailto;
  });
</script>
