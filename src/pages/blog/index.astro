---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";
import { getBlogPosts, urlFor } from "../../utils/sanity";
import { portableTextToPlainText } from "../../utils/portableText";

// Fonte de verdade: Sanity (projeto 1tnejkhf, _type "blog") — o mesmo
// conteúdo que o site antigo em Next.js exibia em /blog.
const posts = await getBlogPosts();

const formatarData = (iso: string | undefined) =>
  iso
    ? new Date(iso).toLocaleDateString("pt-BR", {
        day: "2-digit",
        month: "long",
        year: "numeric",
      })
    : "";
---

<BaseLayout title="Blog — OAMa">
  <main class="font-montserrat text-oama-ink">
    <section class="relative h-[420px] w-full overflow-hidden md:h-[520px]">
      <img
        src="/midias/realizacoes/divulgacao-cientifica.jpg"
        alt="Divulgação científica do OAMa"
        class="absolute inset-0 h-full w-full object-cover object-[50%_18%]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="absolute inset-x-0 bottom-0 z-10 flex flex-col items-center px-6 pb-8 md:pb-16">
        <h1
          class="text-center font-oswald text-[36px] font-bold uppercase leading-none text-white drop-shadow-md md:text-[58px]"
        >
          Blog
        </h1>
        <p
          class="mt-3 max-w-[560px] text-center text-[16px] leading-[24px] text-white drop-shadow-md md:text-[18px] md:leading-[27px]"
        >
          Um espaço para compartilhar e aproximar a ciência de você.
        </p>
      </div>
    </section>

    <section class="bg-[#dfb553]">
      <div class="mx-auto max-w-5xl px-7 py-12 md:px-12 md:py-16">
        {
          posts.length === 0 ? (
            <p class="text-center text-[18px] leading-[27px] text-[#111111]">
              Nenhum post publicado no momento. Volte em breve.
            </p>
          ) : (
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-x-10 md:gap-y-12">
              {posts.map((post: any) => (
                <article class="relative flex flex-col overflow-hidden rounded-[24px] bg-white shadow-sm">
                  {post.mainImage && (
                    <img
                      src={urlFor(post.mainImage).width(800).height(520).fit("crop").auto("format").url()}
                      alt={post.title}
                      class="h-[245px] w-full object-cover md:h-[280px]"
                      loading="lazy"
                    />
                  )}

                  <div class="flex flex-1 flex-col px-6 py-6">
                    {post.publishedAt && (
                      <p class="font-montserrat text-[13px] font-semibold uppercase tracking-[0.08em] text-[#8a6a12]">
                        {formatarData(post.publishedAt)}
                      </p>
                    )}

                    <h2 class="mt-2 font-montserrat text-[20px] font-extrabold leading-[26px] text-[#111111]">
                      {post.title}
                    </h2>

                    <p class="mt-3 text-[16px] leading-[25px] text-[#111111]/85">
                      {portableTextToPlainText(post.body)}
                    </p>

                    {post.author?.name && (
                      <div class="mt-5 flex items-center gap-3">
                        {post.author.image && (
                          <img
                            src={urlFor(post.author.image).width(72).height(72).fit("crop").auto("format").url()}
                            alt={`Foto de ${post.author.name}`}
                            class="h-9 w-9 rounded-full object-cover"
                            loading="lazy"
                          />
                        )}
                        <span class="text-[14px] font-semibold text-[#111111]">
                          {post.author.name}
                        </span>
                      </div>
                    )}

                    <span class="mt-6 inline-block font-montserrat text-[14px] font-bold uppercase tracking-[0.06em] text-[#8a6a12]">
                      Ler post
                    </span>
                  </div>

                  <a
                    href={`/blog/${post.slug}`}
                    aria-label={`Ler o post ${post.title}`}
                    class="absolute inset-0 z-10 rounded-[24px] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#1a2e4a] focus-visible:ring-inset"
                  >
                    <span class="sr-only">Ler o post {post.title}</span>
                  </a>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <WaveDark
      topColor="#dfb553"
      bottomColor="#5ba4d9"
      path1Color="#1e1702"
      path2Color="#fbf5e6"
    />
  </main>
</BaseLayout>
