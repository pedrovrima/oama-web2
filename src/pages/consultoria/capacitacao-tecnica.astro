---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";
import ConsultoriaServico from "../../components/sections/consultoria/ConsultoriaServico.astro";

const colors = {
  yellow: "#dfb553",
  blue: "#5ba4d9",
  cream: "#fbf5e6",
  dark: "#071723",
};

const servicos = [
  "Treinamento em métodos de coleta de dados;",
  "Treinamento em análise de mudas e classificação de idade;",
  "Formação para guias e condutores de observação de aves;",
  "Cursos e oficinas em ornitologia e ecologia das aves;",
  "Assistência técnica para coleta de dados de campo para projetos de pesquisa (iniciação científica, mestrado e doutorado).",
];

const diferenciais = [
  "Instrutores habilitados e certificados nacional e internacionalmente;",
  "Sistema padronizado de ensino-aprendizagem;",
  "Práticas realizadas seguindo ética profissional;",
  "Formação baseada em atividades práticas supervisionadas;",
  "Integração entre teoria e campo.",
];

const publico = [
  "Estudantes e profissionais da área ambiental;",
  "Observadores de aves e da natureza;",
  "Universidades e institutos de pesquisa;",
  "Administração pública e organizações do terceiro setor;",
  "Empresas de consultoria ambiental.",
];

const icones = ["book", "binoculars", "flask", "building"];
---

<BaseLayout
  title="Capacitação Técnica e Formação Profissional em Ornitologia — OAMa"
  navVariant="overlay"
>
  <ConsultoriaServico
    titulo="Capacitação Técnica e Formação Profissional em Ornitologia"
    heroImg="/midias/consultoria/capacitacao.jpg"
    heroAlt="Instrutora do OAMa orientando participante em atividade prática de anilhamento de aves"
    servicos={servicos}
    diferenciais={diferenciais}
    publico={publico}
    icones={icones}
    colors={colors}
  />
  <WaveDark
    topColor="white"
    bottomColor={colors.blue}
    path1Color={colors.yellow}
    path2Color={colors.dark}
  />
</BaseLayout>
