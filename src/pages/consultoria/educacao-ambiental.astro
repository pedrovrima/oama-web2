---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ChaveIconePublico } from "../../data/icones-publico";
import WaveDark from "../../components/sections/WaveDark.astro";
import ConsultoriaServico from "../../components/sections/consultoria/ConsultoriaServico.astro";

const colors = {
  yellow: "#dfb553",
  blue: "#5ba4d9",
  cream: "#fbf5e6",
  dark: "#071723",
};

const servicos = [
  "Programas de educação ambiental;",
  "Oficinas, palestras, cursos e exposições sobre aves silvestres e impactos humanos;",
  "Produção de materiais educativos e informativos;",
  "Mobilização comunitária para mitigar impactos urbanos sobre as aves;",
  "Educação ambiental e ensino do meio com foco em biodiversidade;",
  "Práticas de observação de aves visando a sensibilização ambiental.",
];

const diferenciais = [
  "Design original e personalizado de materiais gráficos e de atividades didáticas;",
  "Conteúdo pautado na transposição didática da ciência para todas as idades;",
  "Abordagens participativas;",
  "Atividades em espaços formais e não-formais de educação;",
  "Práticas que integram a arte ao conhecimento científico e à educação.",
];

const publico = [
  "Escolas, museus e universidades;",
  "Administração pública e organizações do terceiro setor;",
  "Empresas com programas socioambientais;",
  "Projetos de compensação ambiental.",
];

// Ordem e desenhos conforme o cluster do frame 2620:878 do Figma.
const icones: ChaveIconePublico[] = [
  "escolas-museus",
  "orgaos-publicos",
  "sociedade-civil",
  "empresas-consultorias",
];
---

<BaseLayout
  description="Programas de educação ambiental, oficinas, exposições e materiais educativos sobre aves silvestres para escolas, museus, empresas e poder público."
  image="/midias/consultoria/educacao.jpg"
  title="Educação Ambiental e Comunicação Científica — OAMa"
  navVariant="overlay"
>
  <ConsultoriaServico
    titulo="Educação Ambiental e Comunicação Científica"
    heroImg="/midias/consultoria/educacao.jpg"
  heroPos="center 72%"
    heroAlt="Educador ambiental do OAMa conduzindo atividade de campo com estudantes na Mantiqueira"
    servicos={servicos}
    diferenciais={diferenciais}
    publico={publico}
    icones={icones}
    colors={colors}
  />
  <WaveDark
    topColor={colors.blue}
    bottomColor={colors.blue}
    path1Color={colors.yellow}
    path2Color={colors.dark}
  />
</BaseLayout>
