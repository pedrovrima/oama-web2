---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ChaveIconePublico } from "../../data/icones-publico";
import WaveDark from "../../components/sections/WaveDark.astro";
import ConsultoriaServico from "../../components/sections/consultoria/ConsultoriaServico.astro";

const colors = {
  yellow: "#dfb553",
  blue: "#5ba4d9",
  cream: "#fbf5e6",
  dark: "#071723",
};

const servicos = [
  "Inventários e levantamentos;",
  "Monitoramento de longo prazo;",
  "Estudos para diagnóstico ambiental e avaliação de impactos;",
  "Assistência técnica em manejo de avifauna relacionada à conflitos humanos;",
  "Relatórios técnicos e pareceres (planos de manejos e diagnósticos ambientais);",
  "Análise, manejo e gestão de dados biológicos.",
];

const diferenciais = [
  "Equipe qualificada para a coleta de dados padronizados em ornitologia;",
  "Foco no bem estar animal e profissional;",
  "Realização de metodologias sistematizadas e padronizadas.",
];

const publico = [
  "Empresas de consultoria ambiental;",
  "Órgãos ambientais;",
  "Universidades e institutos de pesquisa;",
  "Empreendimentos;",
  "Unidades de conservação.",
];

// Ordem e desenhos conforme o cluster do frame 2620:831 do Figma.
const icones: ChaveIconePublico[] = [
  "empresas-consultorias",
  "empreendimentos-impacto",
  "universidades-pesquisa",
  "unidades-conservacao",
];
---

<BaseLayout
  description="Inventários, monitoramento de longo prazo, diagnósticos ambientais, pareceres técnicos e gestão de dados de avifauna com metodologia padronizada."
  image="/midias/consultoria/monitoramento.jpg"
  title="Monitoramento de Aves e Estudos de Avifauna — OAMa"
  navVariant="overlay"
>
  <ConsultoriaServico
    titulo="Monitoramento de Aves e Estudos de Avifauna"
    heroImg="/midias/consultoria/monitoramento.jpg"
    heroAlt="Anilhador segurando ave silvestre durante sessão de monitoramento de campo"
    servicos={servicos}
    diferenciais={diferenciais}
    publico={publico}
    icones={icones}
    colors={colors}
  />
  <WaveDark
    topColor={colors.blue}
    bottomColor={colors.blue}
    path1Color={colors.yellow}
    path2Color={colors.dark}
  />
</BaseLayout>
