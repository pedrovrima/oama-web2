---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Newsletter — OAMa"
  description="Assine a newsletter do OAMa e seja o primeiro a saber das próximas atividades, cursos e ações de conservação das aves da Mata Atlântica."
  image="/midias/missao/hero-missao.jpg"
  navVariant="overlay"
  noindex
>
  <main class="font-montserrat">
    <!-- HERO full-bleed -->
    <section class="relative min-h-[60vh] w-full overflow-hidden flex items-end">
      <img
        src="/midias/missao/hero-missao.jpg"
        alt="Ave da Mata Atlântica em galho com frutos"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/35"></div>
      <div class="relative z-10 w-full max-w-5xl mx-auto px-6 pb-16">
        <h1 class="font-oswald text-[34px] font-bold uppercase leading-none text-white drop-shadow-md md:text-[56px]">
          Newsletter
        </h1>
      </div>
    </section>

    <!-- FORM -->
    <section class="bg-oama-yellow w-full text-oama-ink">
      <div class="mx-auto max-w-[640px] px-6 py-14 md:py-20">
        <h2 class="font-oswald text-[26px] md:text-[32px] font-bold uppercase leading-tight">
          Assine a newsletter do OAMa
        </h2>
        <p class="mt-3 text-[16px] md:text-[18px] leading-relaxed">
          Seja o primeiro a saber das próximas atividades, cursos e ações de
          conservação. Você receberá um email para confirmar a inscrição.
        </p>

        <form
          data-newsletter-form
          aria-label="Inscrição na newsletter"
          class="mt-8 flex flex-col gap-4"
        >
          <input type="hidden" name="list_slug" value="newsletter" />
          <!-- Honeypot anti-spam: invisível para humanos -->
          <div style="position: absolute; left: -9999px;" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div class="flex flex-col gap-1.5">
              <label for="nl-first" class="text-[14px] font-semibold">Nome</label>
              <input
                id="nl-first"
                type="text"
                name="first_name"
                placeholder="Seu nome"
                class="rounded-full border border-oama-ink/20 bg-white px-5 text-[15px] focus:outline-none focus:ring-2 focus:ring-oama-ink/30"
                style="height: 48px;"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="nl-last" class="text-[14px] font-semibold">Sobrenome</label>
              <input
                id="nl-last"
                type="text"
                name="last_name"
                placeholder="Seu sobrenome"
                class="rounded-full border border-oama-ink/20 bg-white px-5 text-[15px] focus:outline-none focus:ring-2 focus:ring-oama-ink/30"
                style="height: 48px;"
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="nl-email" class="text-[14px] font-semibold">Email</label>
            <input
              id="nl-email"
              type="email"
              name="email"
              required
              placeholder="voce@exemplo.com"
              class="rounded-full border border-oama-ink/20 bg-white px-5 text-[15px] focus:outline-none focus:ring-2 focus:ring-oama-ink/30"
              style="height: 48px;"
            />
          </div>

          <button
            type="submit"
            class="mt-2 inline-flex w-fit items-center justify-center rounded-full bg-oama-ink px-8 font-semibold uppercase tracking-[0.08em] text-white transition hover:brightness-110 disabled:opacity-60"
            style="height: 48px;"
          >
            Quero me inscrever
          </button>

          <p
            data-newsletter-status
            role="status"
            aria-live="polite"
            class="text-[14px] font-semibold empty:hidden"
          ></p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
