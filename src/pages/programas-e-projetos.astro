---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveDark from "../components/sections/WaveDark.astro";

const programas = [
  {
    href: "/programas-e-projetos/monitoramento-de-avifauna",
    titulo: "Programa de Monitoramento de Avifauna da Mantiqueira",
    subtitulo: "Ciência de longo prazo para compreender e proteger as aves da Mantiqueira.",
    imagem: "/midias/programas-e-projetos/card-monitoramento.jpg",
    alt: "Retrato aproximado de ave amarela e oliva na mão de pesquisador durante monitoramento",
  },
  {
    href: "/programas-e-projetos/treinamento-monitoramento-avifauna",
    titulo: "Programa de Treinamento em Monitoramento de Avifauna",
    subtitulo: "Formação de pessoas para pesquisa, anilhamento e trabalho de campo.",
    imagem: "/midias/programas-e-projetos/card-treinamento.jpg",
    alt: "Pesquisadora segurando beija-flor durante sessão de anilhamento do OAMa",
  },
  {
    href: "/programas-e-projetos/acoes-pro-aves",
    titulo: "Programa Ações Pró-Aves",
    subtitulo: "Comunicação, sensibilização e ciência cidadã para aproximar sociedade e aves.",
    imagem: "/midias/programas-e-projetos/card-acoes-pro-aves.jpg",
    alt: "Apresentação teatral com máscaras de aves em atividade educativa do Programa Ações Pró-Aves",
  },
  {
    href: "/programas-e-projetos/projetos-de-pesquisa",
    titulo: "Projetos de Pesquisa",
    subtitulo: "Parcerias científicas que transformam dados em conhecimento para conservação.",
    imagem: "/midias/programas-e-projetos/card-projetos-pesquisa.jpg",
    alt: "Mão segurando beija-flor com a asa e a cauda abertas para exame em campo",
  },
  {
    href: "/programas-e-projetos/fundraising-field-trip",
    titulo: "Fundraising Field Trip",
    subtitulo: "Experiências de campo que conectam conservação, território e apoio financeiro.",
    imagem: "/midias/programas-e-projetos/card-fft.jpg",
    alt: "Grupo caminhando por trilha rochosa entre picos durante Fundraising Field Trip",
  },
  {
    href: "/programas-e-projetos/campanha-jacucara",
    titulo: "Campanha Jacuçara",
    subtitulo: "Uma campanha pela jacutinga, pela juçara e pelas relações ecológicas da floresta.",
    imagem: "/midias/programas-e-projetos/card-jacucara.jpg",
    alt: "Jacutinga (Aburria jacutinga) em palmeira juçara na Mata Atlântica",
  },
  {
    // Decisão do usuário (2026-08-20): cursos entra no mosaico deste hub.
    // Isso também resolve a orfandade de /consultoria/cursos (nenhum link de entrada).
    href: "/consultoria/cursos",
    titulo: "Cursos",
    subtitulo: "Formação em ornitologia, anilhamento e análise de muda, online e presencial.",
    imagem: "/midias/programas-e-projetos/card-cursos.jpg",
    alt: "Asa verde de ave aberta na mão de pesquisador, mostrando o detalhe das penas",
  },
  {
    href: "/programas-e-projetos/pro-aves",
    titulo: "Resultados do Programa Pró-Aves",
    subtitulo: "Campanhas, publicações e resultados reunidos pelo Programa Ações Pró-Aves.",
    imagem: "/proaves2/cover_pro_aves.jpeg",
    alt: "Capa visual do acervo de resultados do Programa Pró-Aves",
  },
];
---

<BaseLayout
  description="Os programas do OAMa: monitoramento da avifauna da Mantiqueira, treinamento de anilhadores, Ações Pró-Aves, pesquisa, cursos e Campanha Jacuçara."
  image="/midias/programas-e-projetos/hub-hero.jpg" title="Programas e Projetos — OAMa">
  <main class="font-montserrat text-oama-ink">
    <!-- Hero Figma: navegação sólida, título baixo para não competir com ela. -->
    <section class="relative h-[255px] w-full overflow-hidden md:h-[580px]">
      <img
        src="/midias/programas-e-projetos/hub-hero.jpg"
        alt="Pesquisador do OAMa segurando ave anilhada na Mantiqueira"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/15"></div>

      <div class="relative z-10 flex h-full items-end justify-start px-12 pb-3 md:justify-center md:px-6 md:pb-10">
        <h1 class="max-w-[210px] font-oswald text-[25px] font-bold uppercase leading-[0.9] text-white drop-shadow-md md:max-w-none md:text-center md:text-[58px]">
          Programas e Projetos
        </h1>
      </div>
    </section>


    <!-- Mosaico do Figma. Os títulos aparecem SOBRE a foto: sem eles a página é
         só um mosaico de imagens e o visitante não sabe para onde cada card leva. -->
    <section class="bg-[#e4ba4c] px-[13px] pb-[54px] pt-4 md:px-6 md:pb-12 md:pt-9">
      <div class="mx-auto grid w-full max-w-[420px] grid-cols-1 gap-3 md:max-w-[840px] md:grid-cols-3 md:gap-[18px]">
        {
          programas.map((programa) => (
            <a
              href={programa.href}
              aria-label={`${programa.titulo}. ${programa.subtitulo}`}
              class="group relative aspect-square overflow-hidden rounded-[12px] focus:outline-none focus-visible:ring-4 focus-visible:ring-white md:rounded-[22px]"
            >
              <img
                src={programa.imagem}
                alt={programa.alt}
                class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                loading="lazy"
              />
              {/* Gradiente: garante contraste do título sobre qualquer foto. */}
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/85 via-black/40 to-transparent"
                aria-hidden="true"
              />

              <div class="pointer-events-none absolute inset-x-0 bottom-0 p-3 md:p-4">
                <h2 class="font-oswald text-[20px] font-bold uppercase leading-[1.15] text-white drop-shadow-md md:text-[19px]">
                  {programa.titulo}
                </h2>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <WaveDark topColor="#e4ba4c" bottomColor="#5ba4d9" path1Color="#1e1702" path2Color="#ffffff" />
  </main>
</BaseLayout>
