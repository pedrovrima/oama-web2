---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";

// Paleta padrão do projeto (mesma usada em consultoria).
const colors = {
  yellow: "#dfb553",
  blue: "#5ba4d9",
  cream: "#fbf5e6",
  dark: "#071723",
};

// Projetos na ORDEM do frame Figma (Desktop_Projetos de Pesquisa 2514:766),
// lidos coluna a coluna de cima para baixo. O campo `tom` reproduz o padrão
// alternado branco/escuro dos cards visto no frame.
// `link` é opcional: só alguns projetos têm material publicado.
const projetos: {
  titulo: string;
  periodo: string;
  imagem: string;
  alt: string;
  tom: string;
  link?: string;
}[] = [
  {
    titulo: "Pesquisa de Percepção Socioambiental - PAN Aves da Mata Atlântica",
    periodo: "2024 - atual",
    imagem: "/midias/programas-e-projetos/pesquisa-card-1.jpg",
    alt: "Ave de peito vermelho-vinho e asas azuis pousada em galho na Mata Atlântica",
    tom: "claro",
    // Relatório da pesquisa, publicado em public/publicacoes/files/.
    link: "/publicacoes/files/OAMa_relatorio_percepcao.pdf",
  },
  {
    titulo: "Migração Altitudinal de Aves na Mantiqueira",
    periodo: "2023 - 2025",
    imagem: "/midias/programas-e-projetos/pesquisa-card-2.jpg",
    alt: "Ave azul com topete vermelho segurada em campo durante estudo de migração altitudinal",
    tom: "escuro",
  },
  {
    titulo: "Levantamento de Aves da Serra da Mantiqueira",
    periodo: "2021 - atual",
    imagem: "/midias/programas-e-projetos/pesquisa-card-3.jpg",
    alt: "Ave marrom listrada pousada em ramo de araucária na Serra da Mantiqueira",
    tom: "escuro",
  },
  {
    titulo: "Dinâmicas populacionais de beija-flores",
    periodo: "2023 - 2025",
    imagem: "/midias/programas-e-projetos/pesquisa-card-4.jpg",
    alt: "Beija-flor com asa e cauda abertas na mão de pesquisador durante anilhamento",
    tom: "claro",
  },
  {
    titulo:
      "Uso da corrugação de bico para auxiliar a classificação de idade de beija-flores",
    periodo: "2022 - 2025",
    imagem: "/midias/programas-e-projetos/pesquisa-card-5.jpg",
    alt: "Detalhe da cabeça e do bico longo de beija-flor verde na mão de pesquisador",
    tom: "claro",
  },
  {
    titulo: "Variação na taxa de captura com redes de neblina",
    periodo: "2025 - atual",
    imagem: "/midias/programas-e-projetos/pesquisa-card-6.jpg",
    alt: "Ave clara capturada em rede de neblina na floresta durante monitoramento",
    tom: "escuro",
  },
  {
    titulo: "Ciclo de muda e classificação de idade de Chiroxiphia caudata",
    periodo: "2019 - atual",
    imagem: "/midias/programas-e-projetos/pesquisa-card-7.jpg",
    alt: "Tangará-dançador (Chiroxiphia caudata) com topete vermelho segurado em campo",
    tom: "escuro",
  },
  {
    titulo: "Aves seguidoras de frutificações de bambu",
    periodo: "2024 - atual",
    imagem: "/midias/programas-e-projetos/pesquisa-card-8.jpg",
    alt: "Ave cinzenta de bico claro segurada na mão durante estudo de aves de bambu",
    tom: "claro",
  },
  {
    titulo:
      "Colisões de aves com vidro: Enxergando soluções para uma ameaça invisível",
    periodo: "2024 - atual",
    imagem: "/midias/programas-e-projetos/pesquisa-card-9.jpg",
    alt: "Ave verde e amarela morta sobre jornal, registro de colisão com vidro",
    tom: "claro",
  },
];
---

<BaseLayout
  description="Projetos de pesquisa do OAMa sobre migração altitudinal, ciclos de muda, beija-flores e colisões com vidro, em parceria com universidades brasileiras."
  image="/midias/programas-e-projetos/pesquisa-hero.jpg" title="Projetos de Pesquisa — OAMa" navVariant="overlay">
  <main class="font-montserrat">
    {/* HERO: full-bleed com foto de fundo e título ancorado ao rodapé */}
    {/* HERO (frame: foto de altura contida, SEM título sobreposto) */}
    <section class="relative h-[300px] w-full overflow-hidden md:h-[620px]">
      <img
        src="/midias/programas-e-projetos/pesquisa-hero.jpg"
        alt="Mão segurando ave de asas abertas durante pesquisa de campo do OAMa"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
    </section>

    {/* Faixa AMARELA: introdução com trecho em destaque */}
    <section class="w-full" style={`background:${colors.yellow};`}>
      <div class="mx-auto max-w-5xl px-6 pt-14 pb-8">
        <h1
          class="mb-10 text-center font-oswald text-[30px] font-bold uppercase leading-[36px] text-oama-ink md:text-[42px] md:leading-[48px]"
        >
          Projetos de Pesquisa
        </h1>

        <div
          class="space-y-5 text-[16px] leading-[24px] text-[#1e1702] text-justify"
        >
          <p>
            O crescente banco de dados oriundo, principalmente, do nosso
            monitoramento padronizado e de longo prazo da avifauna da
            Mantiqueira, impulsiona estudos sobre a história natural e a
            ecologia das espécies e populações locais. Tendo isso como parte
            dos nossos objetivos, compreendemos que a colaboração no meio
            científico funciona <strong
              >como uma relação mutualística, onde todas as partes têm algo a
              ganhar, inclusive a sociedade.</strong
            >
          </p>
          <p>
            O OAMa disponibiliza dados científicos para que estudantes e
            colaboradores parceiros — de diversas instituições de pesquisa,
            como USP, UFRGS, UFRJ e UFSC — possam analisá-los para responder
            perguntas que impulsionem o conhecimento ornitológico e de ecologia
            no Brasil. Esses esforços convertem-se em mais estudos publicados,
            que podem ser traduzidos em narrativas socioambientais marcantes —
            por meio da divulgação científica — e em ferramentas de gestão
            ambiental para tomadas de decisões informadas. A seguir, confira
            alguns de nossos projetos de pesquisa em desenvolvimento ou já
            concluídos.
          </p>
        </div>
      </div>
    </section>

    {/* Grid de cards de projetos (alternância branco/escuro conforme frame) */}
    <section class="w-full pb-16" style={`background:${colors.yellow};`}>
      <div class="mx-auto max-w-5xl px-6">
        <ul
          class="grid gap-6 sm:grid-cols-2"
          aria-label="Projetos de pesquisa do OAMa"
        >
          {
            projetos.map((p) => {
              const escuro = p.tom === "escuro";
              return (
                <li
                  class:list={[
                    "flex flex-col overflow-hidden rounded-2xl shadow-lg",
                    escuro ? "text-white" : "bg-white text-oama-ink",
                  ]}
                  style={escuro ? `background:${colors.dark};` : undefined}
                >
                  <div class="p-3">
                    <div class="h-44 w-full overflow-hidden rounded-xl">
                      <img
                        src={p.imagem}
                        alt={p.alt}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  </div>
                  <div class="flex flex-1 flex-col px-5 pb-6">
                    <h2 class="text-[16px] font-semibold leading-[22px]">
                      {p.link ? (
                        <a
                          href={p.link}
                          class="underline underline-offset-4 hover:opacity-80"
                        >
                          {p.titulo}
                        </a>
                      ) : (
                        p.titulo
                      )}
                    </h2>
                    <p
                      class:list={[
                        "mt-2 text-[14px] leading-[20px]",
                        escuro ? "text-white/70" : "text-oama-ink/70",
                      ]}
                    >
                      {p.periodo}
                    </p>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    {/* Onda amarelo → escuro → azul, para emendar no Footer global (azul) */}
    <WaveDark
      topColor={colors.yellow}
      bottomColor={colors.blue}
      path1Color={colors.dark}
      path2Color={colors.blue}
    />
  </main>
</BaseLayout>
