---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";

const objetivos = [
  "Identificar e descrever a composição de avifauna e sua sazonalidade de forma representativa para a Serra da Mantiqueira.",
  "Estimar padrões demográficos (sobrevivência, produtividade) para as espécies da Mantiqueira em diferentes áreas de ocorrência.",
  "Avaliar a relação entre condições ambientais e climáticas com as taxas demográficas e distribuição das espécies.",
  "Descrever a biologia e ecologia das espécies de aves na Mantiqueira.",
];

const tecnicas = [
  {
    titulo: "Anilhamento com redes de neblina",
    descricao:
      "Captura padronizada com redes finas para anilhamento, biometria, registro de muda e idade, e recaptura em estudos demográficos de longo prazo.",
    imagem: "/midias/programas-e-projetos/monitoramento-tecnica-1.jpg",
    alt: "Pesquisadores do OAMa em sessão de anilhamento com redes de neblina na Mata Atlântica",
  },
  {
    titulo: "Pontos de escuta",
    descricao:
      "Pontos fixos de detecção visual e acústica das aves, conduzidos em períodos padronizados, registrando riqueza, abundância e ocupação das espécies.",
    imagem: "/midias/programas-e-projetos/monitoramento-tecnica-2.jpg",
    alt: "Saltator-de-papo-cinza fotografado durante monitoramento de avifauna na Mantiqueira — foto Eduardo Schultz",
  },
  {
    titulo: "Gravadores autônomos",
    descricao:
      "Gravadores programados instalados em campo que registram áudio de forma contínua, gerando dados acústicos padronizados para análises de biodiversidade.",
    imagem: "/midias/programas-e-projetos/monitoramento-tecnica-3.jpg",
    alt: "Saltator fotografado durante monitoramento de avifauna na Serra da Mantiqueira — foto BirdsAtlantic",
  },
];
---

<BaseLayout title="Programa de Monitoramento de Avifauna da Mantiqueira — OAMa" navVariant="overlay">
  <main class="font-montserrat">
    <!-- HERO with title overlay -->
    <section class="relative min-h-[80vh] md:min-h-[90vh] w-full overflow-hidden flex items-center justify-center">
      <img
        src="/midias/programas-e-projetos/monitoramento-hero.jpg"
        alt="Pesquisadora do OAMa registrando dados de anilhamento com ave na mão na Mantiqueira"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/30"></div>

      <div class="relative z-10 text-center px-6 max-w-4xl">
        <h1
          class="text-[28px] md:text-[48px] lg:text-[56px] leading-[36px] md:leading-[56px] lg:leading-[64px] font-extrabold uppercase text-white font-oswald drop-shadow-lg"
        >
          Programa de Monitoramento <br class="md:hidden" />de Avifauna da Mantiqueira
        </h1>
      </div>
    </section>

    <!-- 1) INTRODUÇÃO + OBJETIVOS PRINCIPAIS -->
    <section class="bg-oama-yellow w-full">
      <div class="max-w-4xl mx-auto px-6 py-14">

        <div
          class="mt-8 space-y-5 text-[18px] leading-[25px] text-white font-montserrat text-justify"
        >
          <p>
            O monitoramento padronizado e de longo-prazo da avifauna na Serra
            da Mantiqueira é uma atividade central na construção do OAMa.
            Como um observatório de aves, o OAMa foi fundado com o objetivo
            de estabelecer e realizar este monitoramento. Os observatórios
            têm a missão de acompanhar um processo ou fenômeno ao longo do
            tempo e do espaço, e os observatórios de aves fazem isso com as
            aves e seus habitats, utilizando a avifauna como ferramenta para
            entender e avaliar as condições e processos ambientais. Nosso
            monitoramento é focado no acompanhamento de padrões demográficos
            e nos efeitos das mudanças ambientais e climáticas na avifauna.
            Mas com os dados coletados de forma padronizada e periódica,
            aprendemos muito mais.
          </p>
        </div>

        <p
          class="mt-10 text-center font-oswald text-[18px] md:text-[20px] font-bold uppercase text-white"
        >
          Nossos objetivos principais com o monitoramento são os seguintes:
        </p>

        <ul class="mt-6 max-w-2xl mx-auto space-y-4">
          {
            objetivos.map((obj) => (
              <li class="flex items-start gap-3 text-white text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] font-montserrat">
                <span
                  class="flex-shrink-0 mt-1 inline-flex h-7 w-7 items-center justify-center rounded-full bg-white shadow-sm"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-[#dfb553]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="3.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </span>
                <span class="text-justify">{obj}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 2) CITAÇÃO DESTACADA (em faixa amarela) -->
    <section class="bg-oama-yellow w-full py-14">
      <div class="max-w-4xl mx-auto px-6">
        <div
          class="flex flex-col items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8 md:h-10 md:w-10 text-white/90 mb-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M9.17 6C6.31 6 4 8.31 4 11.17v6.83h6.83V11.17H7.83C7.83 9.94 8.77 9 10 9V6H9.17zm10 0c-2.86 0-5.17 2.31-5.17 5.17v6.83H20.83V11.17h-2.83c0-1.23.94-2.17 2.17-2.17V6h-0.83z"
            />
          </svg>

          <blockquote
            class="max-w-3xl text-center text-white font-montserrat text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] italic"
          >
            "Programas de monitoramento de longo prazo da biodiversidade
            local são essenciais para entendermos e mitigarmos os efeitos
            das mudanças globais na biodiversidade tropical, ao mesmo tempo
            em que promovem capacitação profissional, educação ambiental e
            divulgação científica".
          </blockquote>

          <figcaption
            class="mt-4 text-white/90 font-montserrat text-[13px] md:text-[15px] leading-[20px]"
          >
            – Dr. Cagan Sekercioglu, Universidade de Utah, Estados Unidos.
          </figcaption>

          <p
            class="mt-8 text-white text-center text-[13px] md:text-[14px] leading-[20px] md:leading-[22px] font-montserrat italic"
          >
            <em>Tradução livre de trecho do artigo</em> "Promoting
            community-based bird monitoring in the tropics: Conservation,
            research, environmental education, capacity-building, and local
            incomes", <em>publicado em 2011 na revista</em> Biological
            Conservation.
          </p>
        </div>
      </div>
    </section>

    <WaveDark
      topColor="#e9b130"
      bottomColor="#fbf5e6"
      path1Color="#fbf5e6"
      path2Color="#fbf5e6"
    />

    <!-- 3) INÍCIO E ÁREAS AMOSTRAIS -->
    <section class="bg-oama-cream w-full">
      <div class="max-w-5xl mx-auto px-6 py-14">
        <h2
          class="text-center text-[22px] md:text-[28px] leading-[28px] md:leading-[32px] font-extrabold uppercase text-oama-ink font-oswald"
        >
          Início e áreas <br class="md:hidden" />amostrais
        </h2>

        <div
          class="mt-10 grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] md:items-center"
        >
          <div
            class="mx-auto md:mx-0 h-[220px] w-[220px] md:h-[280px] md:w-[280px] overflow-hidden rounded-full border-4 border-oama-ink shadow-md"
          >
            <img
              src="/midias/programas-e-projetos/monitoramento-areas-circulo.jpg"
              alt="Equipe do OAMa em atividade de anilhamento e monitoramento na Mantiqueira"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>

          <div
            class="space-y-5 text-[18px] leading-[25px] text-oama-ink font-montserrat text-justify"
          >
            <p>
              Iniciamos o monitoramento padronizado e de longo prazo da
              avifauna na Serra da Mantiqueira em <strong>2018</strong>.
              Desde então, realizamos amostragens em <strong>seis
              diferentes áreas amostrais</strong> entre São Paulo, Rio de
              Janeiro e Minas Gerais.
            </p>
            <p>
              Mantemos uma área modelo fixa, com mais de 6 anos de
              monitoramento continuado no mesmo local. Nosso objetivo é
              expandir nossa área de alcance e manter o acompanhamento fixo
              em diferentes áreas da Mantiqueira.
            </p>
          </div>
        </div>
      </div>
    </section>

    <WaveDark
      topColor="#fbf5e6"
      bottomColor="#e9b130"
      path1Color="#e9b130"
      path2Color="#e9b130"
    />

    <!-- 4) TÉCNICAS COMPLEMENTARES (em faixa amarela) -->
    <section class="bg-oama-yellow w-full">
      <div class="max-w-5xl mx-auto px-6 py-14">
        <h2
          class="text-center text-[22px] md:text-[28px] leading-[28px] md:leading-[32px] font-extrabold uppercase text-white font-oswald"
        >
          Técnicas <br class="md:hidden" />complementares
        </h2>

        <p
          class="mt-6 max-w-3xl mx-auto text-center text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-white font-montserrat text-justify md:text-center"
        >
          Utilizamos três técnicas complementares para a amostragem padrão
          do monitoramento:
        </p>

        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            tecnicas.map((t) => (
              <li class="flex flex-col overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-white/20">
                <div class="h-44 w-full overflow-hidden">
                  <img
                    src={t.imagem}
                    alt={t.alt}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-1 flex-col p-5 text-oama-ink font-montserrat">
                  <h3 class="font-oswald text-[18px] md:text-[20px] font-bold uppercase leading-[22px] md:leading-[24px]">
                    {t.titulo}
                  </h3>
                  <p class="mt-3 text-[14px] md:text-[15px] leading-[20px] md:leading-[22px]">
                    {t.descricao}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <WaveDark
      topColor="#e9b130"
      bottomColor="#fbf5e6"
      path1Color="#fbf5e6"
      path2Color="#fbf5e6"
    />

  </main>
</BaseLayout>
