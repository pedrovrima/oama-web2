---
import { Image } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";

// Fonte de verdade desta página: frame Figma `2498:638` (Desktop_Monitoramento).
// Assets exportados dos próprios nós do frame, para não aproximar por semelhança.
import heroMonitoramento from "../../assets/monitoramento-hero.jpg";
import fundoCitacao from "../../assets/monitoramento-citacao.jpg";
import carrossel1 from "../../assets/monitoramento-carrossel-1.jpg";
import carrossel2 from "../../assets/monitoramento-carrossel-2.jpg";
import carrossel3 from "../../assets/monitoramento-carrossel-3.jpg";
import carrossel4 from "../../assets/monitoramento-carrossel-4.jpg";
import carrossel5 from "../../assets/monitoramento-carrossel-5.jpg";
import carrossel6 from "../../assets/monitoramento-carrossel-6.jpg";
import carrossel7 from "../../assets/monitoramento-carrossel-7.jpg";
import carrossel8 from "../../assets/monitoramento-carrossel-8.jpg";

// Amarelo do frame (#dfb553), o mesmo usado em /areas-de-atuacao. Não é o
// token `oama-yellow` (#e9b130), que é mais saturado que o do Figma.
const amarelo = "#dfb553";
const azul = "#5ba4d9";
const escuro = "#1e1702";

const objetivos = [
  "Identificar e descrever a composição de avifauna e sua sazonalidade de forma representativa para a Serra da Mantiqueira;",
  "Estimar padrões demográficos (sobrevivência, produtividade) para as espécies da Mantiqueira em diferentes áreas de ocorrência;",
  "Avaliar a relação entre condições ambientais e climáticas com as taxas demográficas e distribuição das espécies;",
  "Descrever a biologia e ecologia das espécies de aves na Mantiqueira;",
];

// Carrossel full-bleed logo após a faixa azul. As 8 fotos são os retângulos
// 1023x512 que ficam ao lado do frame no Figma (2502:420, 2502:465, 2498:597,
// 2498:592, 2498:599, 2498:600, 2498:598, 2498:596), nessa ordem.
// Descrições sem afirmar espécie — o Figma não nomeia nenhuma delas.
const carrossel = [
  {
    imagem: carrossel1,
    alt: "Ave de plumagem azul-acinzentada com topete vermelho, pousada na mão de um pesquisador durante o anilhamento",
  },
  {
    imagem: carrossel2,
    alt: "Ave de plumagem verde com coroa alaranjada, pousada em galho na mata",
  },
  {
    imagem: carrossel3,
    alt: "Gavião de plumagem cinza e olhos alaranjados, em close contra a vegetação",
  },
  {
    imagem: carrossel4,
    alt: "Ave de cabeça cinza e peito amarelo vivo, fotografada de perfil",
  },
  {
    imagem: carrossel5,
    alt: "Beija-flor de plumagem verde e azul iridescente, com bico longo, em voo",
  },
  {
    imagem: carrossel6,
    alt: "Ave pequena de tons oliva e asas barradas, pousada em tronco",
  },
  {
    imagem: carrossel7,
    alt: "Ave de plumagem ocre com sobrancelha branca marcada, vista de perfil",
  },
  {
    imagem: carrossel8,
    alt: "Detalhe aproximado da plumagem malhada de uma ave, com desenho de escamas claras",
  },
];

// O frame deixa um bloco vazio de 705px (nó 2502:449, sem conteúdo) entre o
// parágrafo "Iniciamos o monitoramento…" e o das técnicas. Enquanto o Figma não
// define esse bloco, ele é preenchido pela faixa das três técnicas — que é
// conteúdo já existente no site, e não uma invenção nova de layout.
const tecnicas = [
  {
    imagem: "/midias/programas-e-projetos/monitoramento-tecnica-1.jpg",
    alt: "Pesquisadores do OAMa em sessão de anilhamento com redes de neblina na Mata Atlântica",
  },
  {
    imagem: "/midias/programas-e-projetos/monitoramento-tecnica-2.jpg",
    alt: "Saltator-de-papo-cinza fotografado durante monitoramento de avifauna na Mantiqueira — foto Eduardo Schultz",
  },
  {
    imagem: "/midias/programas-e-projetos/monitoramento-tecnica-3.jpg",
    alt: "Saltator fotografado durante monitoramento de avifauna na Serra da Mantiqueira — foto BirdsAtlantic",
  },
];
---

<BaseLayout
  description="Monitoramento padronizado e de longo prazo da avifauna da Serra da Mantiqueira, com anilhamento em redes de neblina, pontos de escuta e gravadores."
  image="/midias/programas-e-projetos/monitoramento-hero-ave-amarela.jpg"
  title="Programa de Monitoramento de Avifauna da Mantiqueira — OAMa"
  navVariant="overlay"
>
  <main class="font-montserrat">
    <!-- HERO — foto de altura contida, sem título sobreposto (frame 2501:398) -->
    <section class="relative h-[240px] w-full overflow-hidden md:h-[420px]">
      <Image
        src={heroMonitoramento}
        alt="Close de ave de peito amarelo-oliva contra fundo verde desfocado"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
    </section>

    <!-- 1) INTRODUÇÃO + OBJETIVOS PRINCIPAIS -->
    <section class="w-full" style={`background: ${amarelo};`}>
      <div class="mx-auto max-w-4xl px-6 py-12 md:py-14">
        <h1
          class="text-center font-oswald text-[24px] font-bold uppercase leading-[30px] text-white md:text-[30px] md:leading-[35px]"
        >
          Programa de Monitoramento de Avifauna da Mantiqueira
        </h1>

        <p
          class="mt-9 text-left md:text-justify font-montserrat text-[18px] leading-[25px] text-oama-ink"
        >
          O monitoramento padronizado e de longo-prazo da avifauna na Serra da
          Mantiqueira é uma atividade central na construção do OAMa. Como um
          observatório de aves, o OAMa foi fundado com o objetivo de estabelecer
          e realizar este monitoramento. <strong>Os observatórios têm a missão de
          acompanhar um processo ou fenômeno ao longo do tempo e do espaço, e os
          observatórios de aves fazem isso com as aves e seus habitats,
          utilizando a avifauna como ferramenta para entender e avaliar as
          condições e processos ambientais.</strong> Nosso monitoramento é focado
          no acompanhamento de padrões demográficos e nos efeitos das mudanças
          ambientais e climáticas na avifauna. Mas com os dados coletados de
          forma padronizada e periódica, aprendemos muito mais. Nossos objetivos
          principais com o monitoramento são os seguintes:
        </p>

        <ul class="mt-10 space-y-6">
          {
            objetivos.map((obj) => (
              <li class="flex items-start gap-6">
                <span
                  class="mt-0.5 inline-flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-white md:h-[43px] md:w-[43px]"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 md:h-6 md:w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke={amarelo}
                    stroke-width="3.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </span>
                <span class="text-left md:text-justify font-montserrat text-[18px] leading-[25px] text-oama-ink">
                  {obj}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 2) CITAÇÃO sobre a foto da asa (nós 2501:408 / 2501:406 / 2501:407).
         No frame a citação ocupa a coluna esquerda, sobre as penas escuras da
         própria foto — não há véu escuro nem aspas decorativas. -->
    <section class="relative w-full overflow-hidden">
      <Image
        src={fundoCitacao}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        aria-hidden="true"
      />
      <!-- Véu só na coluna do texto, para garantir contraste no mobile, onde o
           recorte da foto não deixa as penas escuras exatamente atrás do texto. -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-transparent md:from-black/45 md:via-black/10"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-4xl px-6 py-14 md:py-20">
        <figure class="max-w-[430px]">
          <blockquote
            class="text-left md:text-justify font-montserrat text-[17px] font-semibold italic leading-[24px] text-white md:text-[18px]"
          >
            "Programas de monitoramento de longo prazo da biodiversidade local
            são essenciais para entendermos e mitigarmos os efeitos das mudanças
            globais na biodiversidade tropical, ao mesmo tempo em que promovem
            capacitação profissional, educação ambiental e divulgação
            científica".
          </blockquote>

          <figcaption
            class="mt-5 font-montserrat text-[17px] leading-[24px] tracking-[0.04em] text-white md:text-[18px]"
          >
            – Dr. Cagan Sekercioglu, da Universidade de Utah, nos Estados Unidos.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Faixa azul com a nota de tradução (nós 2501:411 / 2501:412) -->
    <section class="w-full" style={`background: ${azul};`}>
      <div class="mx-auto max-w-4xl px-6 py-9">
        <p
          class="text-left md:text-justify font-montserrat text-[15px] italic leading-[22px] text-white md:text-[16px] md:leading-[24px]"
        >
          Tradução livre de trecho do artigo "Promoting community-based bird
          monitoring in the tropics: Conservation, research, environmental
          education, capacity-building, and local incomes", publicado em 2011 na
          revista científica Biological Conservation.
        </p>
      </div>
    </section>

    <!-- CARROSSEL full-bleed, logo após a faixa azul (nó 2502:420 + setas
         2502:422 / 2502:423). No frame não há onda entre a faixa e o carrossel. -->
    <section
      class="relative w-full overflow-hidden"
      aria-label="Galeria de aves registradas no monitoramento"
      aria-roledescription="carrossel"
    >
      <div class="relative" data-monitoramento-carousel>
        {
          carrossel.map((foto, i) => (
            <Image
              src={foto.imagem}
              alt={foto.alt}
              class:list={[
                "h-[240px] w-full object-cover md:h-[512px]",
                i === 0 ? "" : "hidden",
              ]}
              data-slide={i}
              loading={i === 0 ? "eager" : "lazy"}
            />
          ))
        }

        <button
          type="button"
          data-prev
          aria-label="Foto anterior"
          class="absolute left-4 top-1/2 -translate-y-1/2 text-white drop-shadow-lg transition hover:scale-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-white md:left-8"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8 md:h-[30px] md:w-[30px]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="3"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          data-next
          aria-label="Próxima foto"
          class="absolute right-4 top-1/2 -translate-y-1/2 text-white drop-shadow-lg transition hover:scale-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-white md:right-8"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8 md:h-[30px] md:w-[30px]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="3"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </section>

    <!-- 3) INÍCIO E ÁREAS AMOSTRAIS — no frame é parágrafo corrido sobre o
         amarelo, sem título e sem foto circular (nó 2502:427). -->
    <section class="w-full" style={`background: ${amarelo};`}>
      <div class="mx-auto max-w-4xl px-6 py-12 md:py-14">
        <p
          class="text-left md:text-justify font-montserrat text-[18px] leading-[25px] tracking-[0.04em] text-oama-ink"
        >
          Iniciamos o monitoramento padronizado e de longo prazo da avifauna na
          Serra da Mantiqueira em 2018. Desde então realizamos amostragens em
          seis diferentes áreas amostrais entre São Paulo, Rio de Janeiro e
          Minas Gerais. Mantemos uma área modelo fixa, com mais de 6 anos de
          monitoramento continuado no mesmo local. Nosso objetivo é expandir
          nossa área de alcance e manter o acompanhamento fixo em diferentes
          áreas da Mantiqueira.
        </p>
      </div>

      <!-- Faixa das três técnicas: ocupa o bloco que o Figma deixou vazio. -->
      <div class="grid grid-cols-1 sm:grid-cols-3">
        {
          tecnicas.map((t) => (
            <img
              src={t.imagem}
              alt={t.alt}
              class="h-[200px] w-full object-cover md:h-[280px]"
              loading="lazy"
            />
          ))
        }
      </div>

      <!-- 4) TÉCNICAS COMPLEMENTARES (nó 2502:451) -->
      <div class="mx-auto max-w-4xl px-6 py-12 md:py-14">
        <p
          class="text-left md:text-justify font-montserrat text-[18px] leading-[25px] text-oama-ink"
        >
          Utilizamos três técnicas complementares para a amostragem padrão do
          monitoramento: anilhamento com redes de neblina, pontos de escuta, e
          gravadores autônomos.
        </p>
      </div>
    </section>

    <!-- Onda amarelo → azul, como o nó 2502:452 -->
    <WaveDark
      topColor={amarelo}
      bottomColor={azul}
      path1Color={escuro}
      path2Color={azul}
    />
  </main>
</BaseLayout>

<script>
  // Carrossel do monitoramento: troca a imagem visível via classe "hidden"
  const raiz = document.querySelector<HTMLElement>("[data-monitoramento-carousel]");
  if (raiz) {
    const slides = Array.from(raiz.querySelectorAll<HTMLImageElement>("[data-slide]"));
    let atual = 0;
    const mostrar = (i: number) => {
      atual = (i + slides.length) % slides.length;
      slides.forEach((s, n) => s.classList.toggle("hidden", n !== atual));
    };
    raiz.querySelector("[data-prev]")?.addEventListener("click", () => mostrar(atual - 1));
    raiz.querySelector("[data-next]")?.addEventListener("click", () => mostrar(atual + 1));
  }
</script>
