---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";

const destaques = [
  {
    imagem: "/midias/programas-e-projetos/fft-galeria-1.jpg",
    alt: "Grupo de visitantes passarinhando com binóculos na Serra da Mantiqueira durante Fundraising Field Trip",
    legenda: "Passarinhadas guiadas na Serra da Mantiqueira",
  },
  {
    imagem: "/midias/programas-e-projetos/fft-galeria-2.jpg",
    alt: "Visitante sorridente em trilha próxima a cachoeira durante a Fundraising Field Trip na Mantiqueira",
    legenda: "Trilhas e experiências únicas na Mantiqueira",
  },
  {
    imagem: "/midias/programas-e-projetos/fft-galeria-3.jpg",
    alt: "Pesquisadora do OAMa mostrando ave anilhada para visitante durante a Fundraising Field Trip",
    legenda: "Visitantes participam das atividades de campo do OAMa",
  },
  {
    imagem: "/midias/programas-e-projetos/fft-galeria-4.jpg",
    alt: "Almoço compartilhado em pousada rural durante a Fundraising Field Trip",
    legenda: "Gastronomia e cultura local durante a viagem",
  },
];

---

<BaseLayout title="Fundraising Field Trip — OAMa" navVariant="overlay">
  <main class="font-montserrat">
    <!-- HERO full-bleed com overlay -->
    <section class="relative min-h-[85vh] w-full overflow-hidden flex items-end">
      <img
        src="/midias/programas-e-projetos/fft-hero.jpg"
        alt="Grupo na montanha durante Fundraising Field Trip"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/30"></div>

      <div class="relative z-10 w-full">
        <div class="w-full max-w-5xl mx-auto px-6 pb-20">
          <h1
            class="text-[32px] leading-[38px] font-bold uppercase text-white font-oswald md:text-[48px] md:leading-[54px]"
          >
            Fundraising <br class="md:hidden" />Field Trip
          </h1>
        </div>
      </div>
    </section>

    <!-- 1) INTRODUÇÃO EM DUAS COLUNAS (faixa amarela) -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-5xl mx-auto px-6 py-16">
        <div class="grid md:grid-cols-2 gap-10">
          <div class="space-y-5 text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify">
            <p>
              A <em>"FUNdraising Field Trip"</em> é uma ação de colaboração entre
              o OAMa e o <strong>Klamath Bird Observatory (KBO)</strong>. Esse
              projeto anual, iniciado em <strong>2023</strong>, une captação de
              recursos para os observatórios com ações de sensibilização e
              educação ambiental e fomento ao
              <strong>turismo de conservação</strong>.
            </p>
          </div>
          <div class="space-y-5 text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify">
            <p>
              A ação acontece em forma de uma
              <strong>viagem internacional de cerca de 10 dias</strong>, em que o
              KBO conecta pequenos grupos de visitantes que chegam ao Brasil
              para vivenciar territórios, gastronomia, cultura, vida silvestre,
              paisagens naturais preservadas e projetos de conservação pela
              Serra da Mantiqueira.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2) CARROSSEL DE FOTOS -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-5xl mx-auto px-6 pb-16">
        <div
          class="relative overflow-hidden rounded-lg border-4 border-white shadow-md"
        >
          <ul
            class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none]"
            style="-webkit-overflow-scrolling: touch;"
            aria-label="Galeria de imagens da Fundraising Field Trip"
          >
            {
              destaques.map((d) => (
                <li class="relative flex-shrink-0 w-full snap-center">
                  <img
                    src={d.imagem}
                    alt={d.alt}
                    class="h-[240px] md:h-[350px] w-full object-cover"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
                  <p class="absolute bottom-0 left-0 right-0 px-5 py-4 text-white font-montserrat text-[13px] md:text-[15px] leading-[18px] md:leading-[22px] text-center">
                    {d.legenda}
                  </p>
                </li>
              ))
            }
          </ul>

          <!-- Setas visuais (decorativas) -->
          <span
            class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19l-7-7 7-7"></path>
            </svg>
          </span>
          <span
            class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </div>
      </div>
    </section>

    <!-- 3) FECHAMENTO -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-4xl mx-auto px-6 pb-16">
        <p
          class="text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify"
        >
          Ao longo do trajeto, proporcionamos aos turistas
          <strong>trilhas e passarinhadas únicas</strong> em diversas unidades
          de conservação, além de conversas inspiradoras com
          <strong>cientistas, produtores rurais, ambientalistas e artistas
          locais</strong>. A <em>"FUNdraising Field Trip"</em> é uma viagem
          que cria momentos inesquecíveis para conectar os visitantes às
          aves, aos habitats e às pessoas que os protegem.
        </p>
      </div>
    </section>

    <WaveDark
      topColor="#dfb553"
      bottomColor="#1a2e4a"
      path1Color="#1a2e4a"
      path2Color="#1a2e4a"
    />

  </main>
</BaseLayout>
