---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";

const destaques = [
  {
    imagem: "/midias/programas-e-projetos/fft-galeria-1.jpg",
    alt: "Grupo posando junto à placa do Parque Nacional do Itatiaia, com o Pico das Agulhas Negras ao fundo",
    legenda: "Visitas guiadas a unidades de conservação como o Parque Nacional do Itatiaia",
  },
  {
    imagem: "/midias/programas-e-projetos/fft-galeria-2.jpg",
    alt: "Visitante sorrindo ao lado de cachoeira em trilha durante a Fundraising Field Trip",
    legenda: "Trilhas e experiências únicas na Mantiqueira",
  },
  {
    imagem: "/midias/programas-e-projetos/fft-galeria-3.jpg",
    alt: "Visitante observando de perto ave segurada por pesquisador do OAMa durante atividade de campo",
    legenda: "Visitantes participam das atividades de campo do OAMa",
  },
  {
    imagem: "/midias/programas-e-projetos/fft-galeria-4.jpg",
    alt: "Mesa posta com pratos da culinária local servidos em pousada durante a Fundraising Field Trip",
    legenda: "Gastronomia e cultura local durante a viagem",
  },
];

---

<BaseLayout
  description="Viagem anual de cerca de dez dias entre OAMa e Klamath Bird Observatory que une captação de recursos, turismo de conservação e educação ambiental."
  image="/midias/programas-e-projetos/fft-hero.jpg" title="Fundraising Field Trip — OAMa" navVariant="overlay">
  <main class="font-montserrat">
    <!-- HERO full-bleed com overlay -->
    {/* HERO (frame: foto de altura contida, SEM título sobreposto) */}
    <section class="relative h-[300px] w-full overflow-hidden md:h-[620px]">
      <img
        src="/midias/programas-e-projetos/fft-hero.jpg"
        alt="Grupo em trilha rochosa entre picos e capim durante a Fundraising Field Trip"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
    </section>

    <!-- 1) INTRODUÇÃO EM DUAS COLUNAS (faixa amarela) -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-5xl mx-auto px-6 py-16">
        <h1
          class="mb-10 text-center font-oswald text-[30px] font-bold uppercase leading-[36px] text-oama-ink md:text-[42px] md:leading-[48px]"
        >
          Fundraising Field Trip
        </h1>

        <div class="grid md:grid-cols-2 gap-10">
          <div class="space-y-5 text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify">
            <p>
              A <em>"FUNdraising Field Trip"</em> é uma ação de colaboração entre
              o OAMa e o <strong>Klamath Bird Observatory (KBO)</strong>. Esse
              projeto anual, iniciado em <strong>2023</strong>, une captação de
              recursos para os observatórios com ações de sensibilização e
              educação ambiental e fomento ao
              <strong>turismo de conservação</strong>.
            </p>
          </div>
          <div class="space-y-5 text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify">
            <p>
              A ação acontece em forma de uma
              <strong>viagem internacional de cerca de 10 dias</strong>, em que o
              KBO conecta pequenos grupos de visitantes que chegam ao Brasil
              para vivenciar territórios, gastronomia, cultura, vida silvestre,
              paisagens naturais preservadas e projetos de conservação pela
              Serra da Mantiqueira.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2) CARROSSEL DE FOTOS -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-5xl mx-auto px-6 pb-16">
        <div
          class="relative overflow-hidden rounded-lg border-4 border-white shadow-md"
        >
          <ul
            class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none]"
            style="-webkit-overflow-scrolling: touch;"
            aria-label="Galeria de imagens da Fundraising Field Trip"
          >
            {
              destaques.map((d) => (
                <li class="relative flex-shrink-0 w-full snap-center">
                  <img
                    src={d.imagem}
                    alt={d.alt}
                    class="h-[240px] md:h-[350px] w-full object-cover"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
                  <p class="absolute bottom-0 left-0 right-0 px-5 py-4 text-white font-montserrat text-[13px] md:text-[15px] leading-[18px] md:leading-[22px] text-center">
                    {d.legenda}
                  </p>
                </li>
              ))
            }
          </ul>

          <!-- Setas visuais (decorativas) -->
          <span
            class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19l-7-7 7-7"></path>
            </svg>
          </span>
          <span
            class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </div>
      </div>
    </section>

    <!-- 3) FECHAMENTO (frame 2517:1092: 3 parágrafos) -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-4xl mx-auto px-6 pb-16">
        <div
          class="space-y-5 text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify"
        >
          <p>
            A cada ano, a viagem trilha caminhos levemente diferentes. Já
            percorremos localidades como <strong>São Francisco Xavier (SP),
            Serrinha do Alambari (RJ), Vila de Visconde de Mauá (RJ), Bocaina
            de Minas (MG) e Itamonte (MG)</strong>. Ao longo do trajeto,
            proporcionamos aos turistas <strong>trilhas e passarinhadas
            únicas</strong> em diversas unidades de conservação; e conversas
            inspiradoras com <strong>cientistas, produtores rurais,
            ambientalistas e artistas locais</strong>.
          </p>
          <p>
            A <em>“FUNdraising Field Trip”</em> é uma viagem que cria momentos
            inesquecíveis para conectar os visitantes às aves, aos habitats e às
            pessoas que os protegem.
          </p>
          <p>
            As doações realizadas pelos turistas financiam os programas de
            pesquisa, de treinamento, de educação ambiental e de restauração de
            habitats do OAMa e do KBO.
          </p>
        </div>
      </div>
    </section>

    <WaveDark
      topColor="#dfb553"
      bottomColor="#1a2e4a"
      path1Color="#1a2e4a"
      path2Color="#1a2e4a"
    />

  </main>
</BaseLayout>
