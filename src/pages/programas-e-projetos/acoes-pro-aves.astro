---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";

const atividades = [
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-1.jpg",
    alt: "Apresentação teatral com máscaras de aves em atividade educativa do Programa Ações Pró-Aves",
    legenda: "Teatro e atividades artísticas sobre aves",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-2.jpg",
    alt: "Crianças explorando exposição educativa sobre aves em atividade de campo do OAMa",
    legenda: "Atividades educativas com escolas e comunidades",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-3.jpg",
    alt: "Apresentação sobre colisão de aves em vidros no Congresso Brasileiro de Ornitologia",
    legenda: "Divulgação científica em eventos e congressos",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-4.jpg",
    alt: "Aplicação de marcações em vidro para prevenção de colisões de aves",
    legenda: "Ações práticas de prevenção de colisões com vidros",
  },
];
---

<BaseLayout title="Programa Ações Pró-Aves — OAMa" navVariant="overlay">
  <main class="font-montserrat">
    <!-- HERO full-bleed com overlay -->
    <section class="relative min-h-[85vh] w-full overflow-hidden flex items-end">
      <img
        src="/midias/programas-e-projetos/proaves-hero.jpg"
        alt="Crianças com fantoches educativos do Programa Ações Pró-Aves"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/30"></div>

      <div class="relative z-10 w-full">
        <div class="w-full max-w-5xl mx-auto px-6 pb-20">
          <h1
            class="text-[32px] leading-[38px] font-bold uppercase text-white font-oswald md:text-[48px] md:leading-[54px]"
          >
            Programa Ações <br class="md:hidden" />Pró-Aves
          </h1>
        </div>
      </div>
    </section>

    <!-- 1) MISSÃO E SOBRE O PROGRAMA (faixa amarela) -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-5xl mx-auto px-6 py-16">
        <div class="max-w-3xl space-y-5 text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify">
            <p>
              O Programa Ações Pró-Aves se consolidou como um pilar do OAMa
              para atingir nossa missão de criar pontes com a sociedade e
              promover a conservação da biodiversidade. Esse programa tem como
              objetivo <strong>promover o reconhecimento individual de cada
              cidadão sobre os impactos decorrentes do nosso modo de vida</strong>
              e como podemos, como indivíduos e como sociedade, transformar
              nossos hábitos para promover ações para a conservação das aves.
            </p>
            <p>
              O programa reúne esforços para transpor o conhecimento científico
              e acadêmico em linguagem acessível para a sociedade por meio de
              mídias digitais, exposições, materiais informativos, oficinas de
              artes, teatro, ciência cidadã e outras produções.
            </p>
        </div>
      </div>
    </section>

    <!-- 2) CARROSSEL DE ATIVIDADES -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-5xl mx-auto px-6 pb-16">
        <div
          class="relative overflow-hidden rounded-lg border-4 border-white shadow-md"
        >
          <ul
            class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none]"
            style="-webkit-overflow-scrolling: touch;"
            aria-label="Galeria de atividades do Programa Ações Pró-Aves"
          >
            {
              atividades.map((a) => (
                <li class="relative flex-shrink-0 w-full snap-center">
                  <img
                    src={a.imagem}
                    alt={a.alt}
                    class="h-[240px] md:h-[350px] w-full object-cover"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
                  <p class="absolute bottom-0 left-0 right-0 px-5 py-4 text-white font-montserrat text-[13px] md:text-[15px] leading-[18px] md:leading-[22px] text-center">
                    {a.legenda}
                  </p>
                </li>
              ))
            }
          </ul>

          <!-- Setas visuais (decorativas) -->
          <span
            class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19l-7-7 7-7"></path>
            </svg>
          </span>
          <span
            class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </div>
      </div>
    </section>

    <!-- 3) FECHAMENTO COM LINK -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-4xl mx-auto px-6 pb-16">
        <p
          class="text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify"
        >
          Desde <strong>2022</strong>, o OAMa tem realizado diversas
          atividades, produtos e projetos com o apoio de inúmeros
          parceiros, entre eles o PAN Aves da Mata Atlântica, CEMAVE/ICMBio,
          o CRBio-04, entre outros. Para saber mais sobre as ações e os
          resultados alcançados, <a
            href="/proaves"
            class="underline underline-offset-4 font-semibold hover:opacity-90"
          >
            visite a página de resultados do programa
          </a>.
        </p>
      </div>
    </section>

    <WaveDark
      topColor="#dfb553"
      bottomColor="#1a2e4a"
      path1Color="#1a2e4a"
      path2Color="#1a2e4a"
    />

  </main>
</BaseLayout>
