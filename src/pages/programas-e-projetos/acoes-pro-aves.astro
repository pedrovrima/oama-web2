---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";

const atividades = [
  {
    imagem: "/proaves2/gallery/final1.webp",
    alt: "Pessoa bordando uma ave durante atividade artística do Programa Ações Pró-Aves",
    legenda: "Oficinas de artes sobre aves",
    posicao: "center 72%",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-1.webp",
    alt: "Apresentação teatral com máscaras de aves em atividade educativa do Programa Ações Pró-Aves",
    legenda: "Teatro e atividades artísticas sobre aves",
    posicao: "center",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-2.webp",
    alt: "Crianças explorando exposição educativa sobre aves em atividade de campo do OAMa",
    legenda: "Atividades educativas com escolas e comunidades",
    posicao: "center",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-3.webp",
    alt: "Apresentação sobre colisão de aves em vidros no Congresso Brasileiro de Ornitologia",
    legenda: "Divulgação científica em eventos e congressos",
    posicao: "center",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-4.webp",
    alt: "Aplicação de marcações em vidro para prevenção de colisões de aves",
    legenda: "Ações práticas de prevenção de colisões com vidros",
    posicao: "center",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-5.webp",
    alt: "Participante pintando uma máscara de ave em papel machê durante oficina de artes",
    legenda: "Oficinas de confecção de máscaras de aves",
    posicao: "center",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-6.webp",
    alt: "Roda de conversa entre jovens durante preparação de atividade teatral sobre aves",
    legenda: "Preparação do grupo antes das apresentações",
    posicao: "center",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-7.webp",
    alt: "Gaiola gigante instalada em exposição sobre tráfico de animais silvestres",
    legenda: "Exposições sobre tráfico e caça de animais silvestres",
    posicao: "center",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-8.webp",
    alt: "Educador do OAMa apresentando painéis sobre estudo de aves para estudantes sentados no chão",
    legenda: "Visitas escolares e exposições sobre o estudo das aves",
    posicao: "center",
  },
  {
    imagem: "/midias/programas-e-projetos/proaves-galeria-9.webp",
    alt: "Palestra sobre colisão de aves em vidros durante o Avistar",
    legenda: "Palestras e divulgação científica em eventos",
    posicao: "center",
  },
];
---

<BaseLayout
  description="Programa do OAMa que aproxima sociedade e aves com oficinas de arte, teatro, atividades em escolas, divulgação científica e prevenção de colisões."
  image="/midias/programas-e-projetos/proaves-galeria-1.webp" title="Programa Ações Pró-Aves — OAMa" navVariant="overlay">
  <main class="font-montserrat">
    <!-- HERO: foto de teatro do frame, sem texto sobreposto -->
    <section class="relative h-[164px] w-full overflow-hidden md:h-[320px]">
      <img
        srcset="/midias/programas-e-projetos/proaves-galeria-1-640w.webp 640w, /midias/programas-e-projetos/proaves-galeria-1-960w.webp 960w, /midias/programas-e-projetos/proaves-galeria-1-1280w.webp 1280w, /midias/programas-e-projetos/proaves-galeria-1.webp 1920w"
        sizes="100vw"
        src="/midias/programas-e-projetos/proaves-galeria-1.webp"
        alt="Apresentação teatral com máscaras de aves em atividade educativa do Programa Ações Pró-Aves"
        class="h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </section>

    <!-- 1) MISSÃO E SOBRE O PROGRAMA (faixa amarela) -->
    <section class="w-full" style="background:#dfb553;">
      <div class="mx-auto max-w-5xl px-6 py-10 md:py-12">
        <h1 class="mb-7 text-center font-oswald text-[24px] font-bold uppercase leading-[27px] text-oama-ink md:mb-10 md:text-[30px] md:leading-[34px]">
          Programa <br class="md:hidden" />Ações Pró-Aves
        </h1>
        <div class="mx-auto max-w-3xl space-y-5 text-justify font-montserrat text-[13px] leading-[19px] text-oama-ink md:text-[16px] md:leading-[24px]">
            <p>
              O Programa Ações Pró-Aves se consolidou como um pilar do OAMa
              para atingir nossa missão de criar pontes com a sociedade e
              promover a conservação da biodiversidade. Esse programa tem como
              objetivo <strong>promover o reconhecimento individual de cada
              cidadão sobre os impactos decorrentes do nosso modo de vida</strong>
              e como podemos, como indivíduos e como sociedade, transformar
              nossos hábitos para promover ações para a conservação das aves.
            </p>
        </div>
      </div>
    </section>

    <!-- 2) CARROSSEL DE ATIVIDADES: mídia ocupa toda a largura como no frame -->
    <section class="w-full" style="background:#dfb553;">
        {/* Largura limitada de proposito, apesar de a secao ser full-bleed.
            Numa proporcao de 1,41 a altura acompanha a largura: em 1920px o
            carrossel full-bleed ficava com 1362px de altura e o slide nao cabia
            mais na tela. Com o teto de 880px a altura para em ~624px e a foto
            continua aparecendo inteira. O fundo amarelo da secao preenche as
            laterais. */}
        <div class="relative mx-auto w-full max-w-[880px] overflow-hidden" data-carrossel>
          <ul
            class="carrossel-trilho flex overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none]"
            style="-webkit-overflow-scrolling: touch;"
            aria-label="Galeria de atividades do Programa Ações Pró-Aves"
            tabindex="0"
            data-trilho
          >
            {
              atividades.map((a, i) => (
                <li class="relative flex-shrink-0 w-full snap-center" data-slide={i}>
                  {/* A galeria mistura proporcoes: 4 fotos em ~1,41 e 5 em 2,00
                      (proaves-galeria-5..9). Com altura fixa e largura full-bleed
                      a caixa virava 2,82:1 a 1440px e cortava metade da altura das
                      fotos 3:2. A caixa passa a 1,41, a proporcao da maioria, com
                      `object-contain`: nada e cortado — as 3:2 preenchem e as
                      panoramicas aparecem inteiras, com faixa do fundo acima e
                      abaixo. `object-position` saiu junto porque sem recorte ele
                      nao faz nada; o "center 72%" do primeiro slide existia so
                      para salvar o enquadramento do corte antigo. */}
                  <img
                    src={a.imagem}
                    alt={a.alt}
                    class="w-full aspect-[1.41] object-contain"
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
                  <p class="absolute bottom-0 left-0 right-0 px-5 pt-4 pb-9 text-white font-montserrat text-[13px] md:text-[15px] leading-[18px] md:leading-[22px] text-center">
                    {a.legenda}
                  </p>
                </li>
              ))
            }
          </ul>

          <!-- Setas de navegação -->
          <button
            type="button"
            data-anterior
            aria-label="Imagem anterior"
            class="absolute left-3 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oama-ink disabled:opacity-40"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <button
            type="button"
            data-proximo
            aria-label="Próxima imagem"
            class="absolute right-3 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oama-ink disabled:opacity-40"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </button>

          <!-- Indicadores -->
          <div
            class="absolute bottom-2 left-1/2 flex -translate-x-1/2 gap-2"
            role="tablist"
            aria-label="Selecionar imagem da galeria"
          >
            {
              atividades.map((a, i) => (
                <button
                  type="button"
                  role="tab"
                  data-ponto={i}
                  aria-label={`Imagem ${i + 1} de ${atividades.length}: ${a.legenda}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  class="h-2 w-2 rounded-full bg-white/50 transition aria-selected:w-5 aria-selected:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                />
              ))
            }
          </div>
        </div>
    </section>

    <!-- 3) FECHAMENTO COM LINK -->
    <section class="w-full" style="background:#dfb553;">
      <div class="max-w-4xl mx-auto px-6 pt-10 pb-16 md:pt-[52px]">
        <p
          class="text-[16px] md:text-[18px] leading-[24px] md:leading-[26px] text-oama-ink font-montserrat text-justify"
        >
          O programa reúne esforços para transpor o conhecimento científico e
          acadêmico em linguagem acessível para a sociedade por meio de mídias
          digitais, exposições, materiais informativos, oficinas de artes,
          teatro, ciência cidadã e outras produções. <strong>O programa Ações
          Pró-Aves impulsiona o potencial de cada pessoa para tornar o mundo
          melhor para as aves e para nós.</strong> Os temas focais em pauta são
          colisão de aves em vidros, tráfico e caça de animais silvestres,
          poluição sonora, poluição luminosa, uso correto de comedouros e
          bebedouros e os impactos de pets sobre as aves.
        </p>
        <p class="mt-5 text-[16px] leading-[24px] text-oama-ink md:text-[18px] md:leading-[26px]">
          Desde <strong>2022</strong>, o OAMa tem realizado diversas
          atividades, produtos e projetos com o apoio de inúmeros
          parceiros, entre eles o PAN Aves da Mata Atlântica, CEMAVE/ICMBio,
          o CRBio-04, entre outros. Para saber mais sobre as ações e os
          resultados alcançados, <a
            href="/proaves"
            class="underline underline-offset-4 font-semibold hover:opacity-90"
          >
            visite a página de resultados do programa
          </a> ou baixe os materiais informativos na <a
            href="/downloads"
            class="underline underline-offset-4 font-semibold hover:opacity-90"
          >aba Downloads</a>.
        </p>
      </div>
    </section>

    <WaveDark
      topColor="#dfb553"
      bottomColor="#1a2e4a"
      path1Color="#1a2e4a"
      path2Color="#1a2e4a"
    />

  </main>
</BaseLayout>

<style>
  /* A barra de rolagem fica escondida: a navegação é feita pelas setas e pelos pontos. */
  .carrossel-trilho::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const carrossel = document.querySelector<HTMLElement>("[data-carrossel]");
  const trilho = carrossel?.querySelector<HTMLElement>("[data-trilho]");

  if (carrossel && trilho) {
    const anterior = carrossel.querySelector<HTMLButtonElement>("[data-anterior]");
    const proximo = carrossel.querySelector<HTMLButtonElement>("[data-proximo]");
    const pontos = Array.from(
      carrossel.querySelectorAll<HTMLButtonElement>("[data-ponto]")
    );
    const total = trilho.querySelectorAll("[data-slide]").length;

    const indiceAtual = () =>
      Math.round(trilho.scrollLeft / trilho.clientWidth);

    const irPara = (indice: number) => {
      const alvo = Math.max(0, Math.min(total - 1, indice));
      trilho.scrollTo({ left: alvo * trilho.clientWidth, behavior: "smooth" });
    };

    const sincronizar = () => {
      const atual = indiceAtual();
      pontos.forEach((ponto, i) =>
        ponto.setAttribute("aria-selected", String(i === atual))
      );
      if (anterior) anterior.disabled = atual <= 0;
      if (proximo) proximo.disabled = atual >= total - 1;
    };

    anterior?.addEventListener("click", () => irPara(indiceAtual() - 1));
    proximo?.addEventListener("click", () => irPara(indiceAtual() + 1));
    pontos.forEach((ponto, i) => ponto.addEventListener("click", () => irPara(i)));

    trilho.addEventListener("keydown", (evento) => {
      if (evento.key === "ArrowRight") {
        evento.preventDefault();
        irPara(indiceAtual() + 1);
      } else if (evento.key === "ArrowLeft") {
        evento.preventDefault();
        irPara(indiceAtual() - 1);
      }
    });

    let agendado = 0;
    trilho.addEventListener("scroll", () => {
      window.clearTimeout(agendado);
      agendado = window.setTimeout(sincronizar, 80);
    });
    window.addEventListener("resize", sincronizar);

    sincronizar();
  }
</script>
