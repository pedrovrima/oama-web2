---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDark from "../../components/sections/WaveDark.astro";

const gallery = [
  "/proaves2/gallery/final1.jpg",
  "/proaves2/gallery/final2.jpg",
  "/proaves2/gallery/final3.jpg",
  "/proaves2/gallery/final4.jpg",
  "/proaves2/gallery/final5.jpg",
  "/proaves2/gallery/final6.jpg",
  "/proaves2/gallery/final7.jpg",
  "/proaves2/gallery/final8.jpg",
  "/proaves2/gallery/final9.jpg",
  "/proaves2/gallery/final10.jpg",
  "/proaves2/gallery/final11.jpg",
];
---

<BaseLayout
  description="Acervo do Programa Ações Pró-Aves: campanhas, publicações, cartilhas, oficinas e registros reunidos pelo OAMa com o apoio de parceiros desde 2022."
  image="/proaves2/cover_pro_aves.jpeg" title="Resultados do Programa Pró-Aves — OAMa">
  <main class="font-montserrat bg-[#201700] text-[#2d2107]">
    <section class="relative h-[360px] overflow-hidden md:h-[420px]">
      <img
        src="/proaves2/cover_pro_aves.jpeg"
        alt="Registro visual do Programa Pró-Aves"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
    </section>

    <section class="bg-[#dfb553]">
      <div class="mx-auto max-w-5xl px-6 py-12 md:py-14">
        <p class="mb-4 text-center font-oswald text-[14px] font-bold uppercase tracking-[0.2em] text-[#1e1702]/80 md:text-[16px]">
          Acervo legado / resultados do projeto
        </p>
        <h1 class="mb-8 text-center font-oswald text-[34px] font-bold uppercase leading-none text-[#1e1702] md:text-[56px]">
          Resultados do Programa Pró-Aves
        </h1>
        <div class="mx-auto max-w-4xl space-y-6 text-[16px] leading-8 md:text-[18px] md:leading-9">
          <p>
            Reunimos aqui os resultados, materiais e registros produzidos pelo Programa Ações Pró-Aves ao longo dos anos: campanhas, publicações, cartilhas e os dados reunidos com a ajuda do público.
          </p>
          <p>
            Para conhecer o programa e suas frentes de atuação, visite a <a href="/programas-e-projetos/acoes-pro-aves" class="underline underline-offset-4 hover:opacity-80">página do Programa Ações Pró-Aves</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="relative bg-[#dfb553]">
      <div class="mx-auto max-w-6xl px-0 md:px-0">
        <div class="relative overflow-hidden">
          <img
            id="proaves-carousel-image"
            src={gallery[0]}
            alt="Registro de atividade do programa Ações Pró-Aves"
            class="h-[360px] w-full object-cover md:h-[520px]"
            loading="lazy"
          />
          <button
            type="button"
            id="proaves-prev"
            class="absolute left-4 top-1/2 z-10 -translate-y-1/2 text-5xl font-light text-white drop-shadow-lg transition hover:scale-110"
            aria-label="Imagem anterior"
          >
            ‹
          </button>
          <button
            type="button"
            id="proaves-next"
            class="absolute right-4 top-1/2 z-10 -translate-y-1/2 text-5xl font-light text-white drop-shadow-lg transition hover:scale-110"
            aria-label="Próxima imagem"
          >
            ›
          </button>
        </div>
      </div>
    </section>

    <section class="bg-[#dfb553]">
      <div class="mx-auto max-w-5xl px-6 py-12 md:py-14">
        <div class="mx-auto max-w-4xl space-y-8 text-[16px] leading-8 md:text-[18px] md:leading-9">
          <p>
            O programa reúne esforços para transpor o conhecimento científico e acadêmico em linguagem acessível para a sociedade por meio de mídias digitais em redes sociais, exposições em áreas públicas e escolas, elaboração e distribuição de materiais informativos impressos, oficinas de artes, teatro, ciência cidadã e outras produções.
            <strong> O programa Ações Pró-Aves impulsiona o potencial de cada pessoa para tornar o mundo melhor para as aves e para nós. </strong>
          </p>

          <p>
            Desde 2022, o OAMa tem realizado diversas atividades, produtos e projetos com o apoio de inúmeros parceiros, entre eles o PAN Aves da Mata Atlântica, CEMAVE/ICMBio, o CRBio-04, entre outros.
          </p>

          <p>
            Se quiser ver a apresentação principal do programa, acesse a
            <a href="/programas-e-projetos/acoes-pro-aves" class="underline underline-offset-4 hover:text-black">página descritiva em Ações Pró-Aves</a>.
            Para materiais e desdobramentos específicos desta camada histórica, fale com o OAMa em
            <a href="mailto:contato@oama.eco.br?subject=Materiais%20Programa%20Pr%C3%B3-Aves" class="underline underline-offset-4 hover:text-black">contato@oama.eco.br</a>.
          </p>
        </div>
      </div>
    </section>

    <div class="bg-[#201700]">
      <div class="h-10 w-full bg-[#dfb553] [clip-path:ellipse(70%_100%_at_50%_0%)]"></div>
      <div class="h-8 w-full bg-white [clip-path:ellipse(70%_100%_at_50%_100%)]"></div>
      <div class="h-12 w-full bg-[#67a8db] [clip-path:ellipse(72%_100%_at_50%_0%)]"></div>
    </div>

  </main>

  <script define:vars={{ gallery }}>
    const img = document.getElementById('proaves-carousel-image');
    const prev = document.getElementById('proaves-prev');
    const next = document.getElementById('proaves-next');
    let current = 0;

    const render = () => {
      if (img) img.src = gallery[current];
    };

    prev?.addEventListener('click', () => {
      current = (current - 1 + gallery.length) % gallery.length;
      render();
    });

    next?.addEventListener('click', () => {
      current = (current + 1) % gallery.length;
      render();
    });
  </script>
</BaseLayout>
