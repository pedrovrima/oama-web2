---
/**
 * Carrossel de fotos padrao do site.
 *
 * Extraido do carrossel de /programas-e-projetos/acoes-pro-aves, que virou a
 * referencia: uma foto por slide, setas, pontos, legenda opcional, arrasto e
 * teclado.
 *
 * Duas regras de enquadramento, que existem porque a versao anterior errava
 * justamente nisso:
 *
 * 1. **A altura vem de `aspect-ratio`, nunca de pixel fixo.** Com `w-full` +
 *    `h-[512px]` so a largura acompanhava a tela, entao a proporcao da caixa
 *    crescia junto: a 1440px o slide virava 2,8:1 e o `object-cover` descartava
 *    ate metade da foto. Com `aspect-ratio` o enquadramento e o mesmo em
 *    qualquer largura.
 *
 * 2. **`larguraMaxima` nao e cosmetico.** Como a altura acompanha a largura,
 *    uma galeria full-bleed em 1,41 chega a 1362px de altura num monitor de
 *    1920 — o slide deixa de caber na tela. O teto e o que mantem a foto
 *    inteira E visivel de uma vez.
 *
 * `proporcao` deve casar com as fotos daquela galeria: batendo, a foto preenche
 * a caixa sem corte e sem faixa. Quando a galeria mistura proporcoes, use a da
 * maioria — `object-contain` garante que as demais aparecam inteiras, com faixa
 * do fundo da secao ao redor.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Foto {
  /** Caminho em public/ (string) ou import de src/assets (ImageMetadata). */
  imagem: string | ImageMetadata;
  alt: string;
  legenda?: string;
}

interface Props {
  fotos: Foto[];
  /** aria-label do carrossel. Descreva o conteudo, nao o widget. */
  rotulo: string;
  /**
   * Proporcao da caixa, no formato de `aspect-ratio` do CSS ("1.41", "2 / 1").
   * Case com as fotos da galeria.
   */
  proporcao?: string;
  /** Teto de largura em px. `null` deixa full-bleed — so para proporcao larga. */
  larguraMaxima?: number | null;
  ajuste?: "cover" | "contain";
  class?: string;
}

const {
  fotos,
  rotulo,
  proporcao = "1.41",
  larguraMaxima = 880,
  ajuste = "contain",
  class: classe = "",
} = Astro.props;

// Estas duas vao inline de proposito: o Tailwind varre o codigo como texto e
// nao gera classe montada em template literal (`aspect-[${proporcao}]` sairia
// sem regra nenhuma).
const estiloCaixa = larguraMaxima ? `max-width:${larguraMaxima}px;` : "";
const estiloFoto = `aspect-ratio:${proporcao};object-fit:${ajuste};`;

const temLegenda = fotos.some((f) => f.legenda);
---

<div
  class:list={["relative mx-auto w-full overflow-hidden", classe]}
  style={estiloCaixa}
  data-carrossel
>
  <ul
    class="carrossel-trilho flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none]"
    style="-webkit-overflow-scrolling: touch;"
    aria-label={rotulo}
    tabindex="0"
    data-trilho
  >
    {
      fotos.map((foto, i) => (
        <li class="relative w-full flex-shrink-0 snap-center" data-slide={i}>
          {typeof foto.imagem === "string" ? (
            <img
              src={foto.imagem}
              alt={foto.alt}
              class="w-full"
              style={estiloFoto}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          ) : (
            <Image
              src={foto.imagem}
              alt={foto.alt}
              class="w-full"
              style={estiloFoto}
              loading={i === 0 ? "eager" : "lazy"}
            />
          )}

          {foto.legenda && (
            <>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
              <p class="absolute bottom-0 left-0 right-0 px-5 pb-9 pt-4 text-center font-montserrat text-[13px] leading-[18px] text-white md:text-[15px] md:leading-[22px]">
                {foto.legenda}
              </p>
            </>
          )}
        </li>
      ))
    }
  </ul>

  {
    fotos.length > 1 && (
      <>
        <button
          type="button"
          data-anterior
          aria-label="Imagem anterior"
          class="absolute left-3 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oama-ink disabled:opacity-40"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          data-proximo
          aria-label="Próxima imagem"
          class="absolute right-3 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-oama-ink shadow-md transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oama-ink disabled:opacity-40"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <div
          class:list={[
            "absolute left-1/2 flex -translate-x-1/2 gap-2",
            // Sem legenda a faixa de baixo fica livre, entao os pontos sobem.
            temLegenda ? "bottom-2" : "bottom-3",
          ]}
          role="tablist"
          aria-label="Selecionar imagem da galeria"
        >
          {fotos.map((foto, i) => (
            <button
              type="button"
              role="tab"
              data-ponto={i}
              aria-label={`Imagem ${i + 1} de ${fotos.length}${foto.legenda ? `: ${foto.legenda}` : ""}`}
              aria-selected={i === 0 ? "true" : "false"}
              class="h-2 w-2 rounded-full bg-white/50 shadow transition aria-selected:w-5 aria-selected:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            />
          ))}
        </div>
      </>
    )
  }
</div>

<style>
  .carrossel-trilho::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // querySelectorAll, nao querySelector: a versao anterior vivia inline na
  // pagina e assumia um carrossel por rota. Como componente, pode haver varios.
  document.querySelectorAll<HTMLElement>("[data-carrossel]").forEach((carrossel) => {
    const trilho = carrossel.querySelector<HTMLElement>("[data-trilho]");
    if (!trilho) return;

    const anterior = carrossel.querySelector<HTMLButtonElement>("[data-anterior]");
    const proximo = carrossel.querySelector<HTMLButtonElement>("[data-proximo]");
    const pontos = Array.from(
      carrossel.querySelectorAll<HTMLButtonElement>("[data-ponto]"),
    );
    const total = trilho.querySelectorAll("[data-slide]").length;

    const indiceAtual = () => Math.round(trilho.scrollLeft / trilho.clientWidth);

    const irPara = (indice: number) => {
      const alvo = Math.max(0, Math.min(total - 1, indice));
      trilho.scrollTo({ left: alvo * trilho.clientWidth, behavior: "smooth" });
    };

    const sincronizar = () => {
      const atual = indiceAtual();
      pontos.forEach((ponto, i) =>
        ponto.setAttribute("aria-selected", String(i === atual)),
      );
      if (anterior) anterior.disabled = atual <= 0;
      if (proximo) proximo.disabled = atual >= total - 1;
    };

    anterior?.addEventListener("click", () => irPara(indiceAtual() - 1));
    proximo?.addEventListener("click", () => irPara(indiceAtual() + 1));
    pontos.forEach((ponto, i) => ponto.addEventListener("click", () => irPara(i)));

    trilho.addEventListener("keydown", (evento) => {
      if (evento.key === "ArrowRight") {
        evento.preventDefault();
        irPara(indiceAtual() + 1);
      } else if (evento.key === "ArrowLeft") {
        evento.preventDefault();
        irPara(indiceAtual() - 1);
      }
    });

    let agendado = 0;
    trilho.addEventListener("scroll", () => {
      window.clearTimeout(agendado);
      agendado = window.setTimeout(sincronizar, 80);
    });
    window.addEventListener("resize", sincronizar);

    sincronizar();
  });
</script>
