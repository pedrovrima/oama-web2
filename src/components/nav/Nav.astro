---
const {
  variant = "default", // "default" | "overlay"
} = Astro.props;

const links = [
  { href: "/sobre", label: "Sobre" },
  { href: "/areas-de-atuacao", label: "Áreas de Atuação" },
  { href: "/programas-e-projetos", label: "Programas e Projetos" },
  { href: "/consultoria", label: "Prestação de Serviços" },
  { href: "/realizacoes", label: "Realizações" },
  { href: "https://use.oama.eco.br", label: "Loja" },
];

const isOverlay = variant === "overlay";

const base = "z-40 w-full";

// Overlay: transparent over the hero photo (white links), turns solid white on
// scroll via the script below (toggling the `is-scrolled` class). Default: solid.
const styles = isOverlay
  ? "absolute top-0 left-0 right-0 bg-transparent transition-colors duration-300"
  : "sticky top-0 bg-white/90 shadow-sm backdrop-blur";
---

<header class={`${base} ${styles}`} data-nav-overlay={isOverlay ? "true" : undefined}>
  <!--
    Mobile layout  (< md):
      - Fixed height ~66px via py-2 (approx 16px top+bottom) + 50px logo = ~66px
      - Relative container so the centered logo can use absolute centering
      - Hamburger pinned to the right with ml-auto
    Desktop layout (md+):
      - flex, justify-between: logo left | nav center | Apoie right
  -->
  <div class="relative mx-auto flex min-h-[66px] max-w-6xl items-center px-4 py-2 md:min-h-0 md:justify-between md:py-3">

    <!-- ── MOBILE: round logo centered absolutely ── -->
    <a
      href="/"
      class="absolute left-1/2 -translate-x-1/2 md:hidden"
      aria-label="Início"
    >
      <img
        src="/brand/logo-round.png"
        alt="OAMa"
        class="h-[50px] w-[50px] rounded-full object-cover"
      />
    </a>

    <!-- ── DESKTOP: SVG logo, left-aligned ── -->
    <a href="/" class="hidden md:flex items-center gap-2" aria-label="Início">
      <img src="/brand/logo-round.png" alt="OAMa" class="h-9 w-auto" />
    </a>

    <!-- ── DESKTOP nav: center ── -->
    <nav class={`hidden items-center gap-6 text-xs font-semibold md:flex ${isOverlay ? "nav-links-overlay text-white" : "text-oama-ink/80"}`}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="border-b-2 border-transparent pb-1 transition hover:border-oama-yellow"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- ── DESKTOP "Apoie" CTA (hidden on mobile) ── -->
    <a
      href="/apoie"
      class="hidden md:inline-flex rounded-full bg-oama-yellow px-4 py-2 text-xs font-extrabold uppercase tracking-[0.12em] text-oama-ink shadow-sm hover:brightness-95"
    >
      Apoie
    </a>

    <!-- ── MOBILE: spacer so hamburger aligns right (logo is absolute) ── -->
    <span class="flex-1 md:hidden" aria-hidden="true"></span>

    <!-- ── MOBILE: hamburger button (hidden on desktop) ── -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden flex flex-col justify-center items-center gap-1.5 p-1 focus:outline-none"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class={`nav-bar block w-6 h-0.5 ${isOverlay ? "bg-white" : "bg-oama-ink"}`}></span>
      <span class={`nav-bar block w-6 h-0.5 ${isOverlay ? "bg-white" : "bg-oama-ink"}`}></span>
      <span class={`nav-bar block w-6 h-0.5 ${isOverlay ? "bg-white" : "bg-oama-ink"}`}></span>
    </button>

  </div>
</header>

<!-- Fundo clicável: fecha o menu ao tocar na parte da página que continua visível -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-[99] hidden md:hidden"
  aria-hidden="true"
>
</div>

<!--
  ── Painel do menu mobile ──
  No Figma (frame 2214:169) o menu é APENAS um painel branco levemente
  transparente que desce do topo. A foto da ave e o bloco "Conservação com
  Ciência" que aparecem no frame são a home ATRÁS do painel, não conteúdo do
  menu — por isso o painel não tem imagem de fundo nem título próprio, e não
  cobre a tela inteira: termina depois do "Apoie" e deixa a página aparecer.
-->
<div
  id="mobile-menu"
  class="fixed inset-x-0 top-0 z-[100] flex transform flex-col bg-white/90 backdrop-blur-sm transition-transform duration-300 ease-in-out md:hidden"
  style="transform: translateY(-100%);"
  aria-hidden="true"
>
  <!-- Menu header: round logo centered, X close button right -->
  <div class="relative flex items-center justify-between bg-white px-4 py-2" style="min-height: 66px;">
    <a href="/" aria-label="Início" class="absolute left-1/2 -translate-x-1/2">
      <img
        src="/brand/logo-round.png"
        alt="OAMa"
        class="h-[50px] w-[50px] rounded-full object-cover"
      />
    </a>
    <span class="flex-1" aria-hidden="true"></span>
    <button
      id="mobile-menu-close"
      class="flex flex-col justify-center items-center gap-1.5 p-1 focus:outline-none"
      aria-label="Fechar menu"
    >
      <!-- X icon: two rotated bars -->
      <span class="block w-6 h-0.5 bg-[#13414f] rotate-45 translate-y-[0.375rem]"></span>
      <span class="block w-6 h-0.5 bg-[#13414f] -rotate-45 -translate-y-[0.375rem]"></span>
    </button>
  </div>

  <!-- Nav links: vertically stacked, left-aligned, gold/yellow (Figma) -->
  <nav class="relative flex flex-col items-start gap-6 px-8 pb-12 pt-8">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="text-[20px] font-semibold text-oama-yellow hover:text-oama-ink transition-colors duration-150"
          style="font-family: 'Montserrat', sans-serif;"
        >
          {link.label}
        </a>
      ))
    }
    <!-- "Apoie" CTA pill, left-aligned right after the links -->
    <a
      href="/apoie"
      class="mt-2 inline-flex rounded-full bg-oama-yellow px-7 py-2.5 text-sm font-extrabold uppercase tracking-[0.12em] text-oama-ink shadow-sm hover:brightness-95"
    >
      Apoie
    </a>
  </nav>
</div>

<style>
  /* When the overlay nav scrolls past the hero, it becomes solid white and the
     links/hamburger flip to dark for readability. */
  header[data-nav-overlay].is-scrolled {
    background-color: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
  }
  header[data-nav-overlay].is-scrolled .nav-links-overlay {
    color: rgb(30 23 2 / 0.8);
  }
  header[data-nav-overlay].is-scrolled .nav-bar {
    background-color: #1e1702;
  }

  /* Mobile: o Figma mostra a barra BRANCA SÓLIDA sobre o hero (não transparente).
     Abaixo de md o overlay vira sólido e os elementos escurecem. */
  @media (max-width: 767px) {
    header[data-nav-overlay] {
      position: sticky;
      background-color: rgb(255 255 255 / 0.95);
      backdrop-filter: blur(8px);
      box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
    }
    header[data-nav-overlay] .nav-bar {
      background-color: #1e1702;
    }
    header[data-nav-overlay] .nav-links-overlay {
      color: rgb(30 23 2 / 0.8);
    }
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const closeBtn = document.getElementById("mobile-menu-close");
  const backdrop = document.getElementById("mobile-menu-backdrop");

  function openMenu() {
    if (!menu || !toggle) return;
    menu.style.transform = "translateY(0)";
    menu.setAttribute("aria-hidden", "false");
    toggle.setAttribute("aria-expanded", "true");
    backdrop?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.style.transform = "translateY(-100%)";
    menu.setAttribute("aria-hidden", "true");
    toggle.setAttribute("aria-expanded", "false");
    backdrop?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.getAttribute("aria-hidden") === "false";
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  // Close when a nav link inside the menu is clicked
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Overlay nav: turn solid white once the user scrolls past the hero top.
  const overlayHeader = document.querySelector<HTMLElement>(
    "header[data-nav-overlay]"
  );
  if (overlayHeader) {
    const onScroll = () => {
      overlayHeader.classList.toggle("is-scrolled", window.scrollY > 24);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
