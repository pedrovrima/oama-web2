      </div>
    </div>
  </div>

  <!-- Yellow bottom bar -->
  <div class="w-full flex items-center justify-center" style="background: #eab231; height: 147px;">
    <img
      src="/brand/logo-round.png"
      alt="OAMa"
      class="h-20 w-auto"
      loading="lazy"
    />
  </div>
</footer>

<script>
  // Global: liga o form do rodapé e qualquer outro form de newsletter da página
  // (ex.: /newsletter). Idempotente — não re-liga forms já conectados.
  import { wireNewsletterForms } from "../../scripts/newsletter";
  wireNewsletterForms();
</script>
