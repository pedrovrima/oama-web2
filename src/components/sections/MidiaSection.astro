---
import { getMidiaItems, urlFor } from "../../utils/sanity";
import CardSection from "./CardSection.astro";

// Sem fallback fabricado: o conteúdo desta seção vem do Sanity.
// O que havia aqui eram 5 matérias INVENTADAS (G1, National Geographic, BBC,
// Globo Rural, Folha) com fotos do Unsplash e href="#". Publicar imprensa
// fictícia é um problema de credibilidade para uma ONG científica, então a
// seção simplesmente não é renderizada enquanto não houver itens reais.

const items = await getMidiaItems();

const cards = items.map((item) => ({
  image: urlFor(item.image).width(480).height(474).fit("crop").auto("format").url(),
  label: item.label,
  title: item.title,
  href: item.link ?? undefined,
}));
---

{cards.length > 0 && (
<CardSection
  sectionTitle="OAMa na Mídia"
  subtitle="Acompanhe nosso trabalho"
  bg="#dfb553"
  id="midia-section"
  cards={cards}
/>
)}
