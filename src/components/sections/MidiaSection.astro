---
import { getMidiaItems, urlFor } from "../../utils/sanity";
import CardSection from "./CardSection.astro";

// Aparições do OAMa na mídia, com título e link do documento oficial de redação
// do site (Google Doc do cliente, seção "OAMa NA MÍDIA"). Ficam no código porque
// o Sanity ainda não tem itens; quando tiver, os de lá têm prioridade.
// As 3 primeiras têm arte enviada pelo OAMa. As duas seguintes usam a
// thumbnail que o próprio YouTube serve por ID do vídeo
// (img.youtube.com/vi/<ID>/maxresdefault.jpg) — é um frame do vídeo, não
// arte de terceiro. As matérias de G1 e ICMBio não usam a imagem do veículo:
// todas trazem arte ou foto do próprio OAMa. A do G1 Sul do Rio não tem imagem
// específica, então repete a foto de anilhamento já usada em outras páginas.
const MIDIA = [
  {
    image: "/midias/home/midia/campanha-escute-as-aves.webp",
    label: "PAN Aves da Mata Atlântica",
    title: "Campanha “Escute as Aves” do PAN Aves da Mata Atlântica",
    href: "https://www.youtube.com/watch?v=6UMyPnKaBWk",
  },
  {
    image: "/midias/home/midia/colisao-aves-vidros.webp",
    label: "Repórter Eco",
    title: "A colisão de aves em vidros",
    href: "https://youtu.be/H5Hp-zX6yuA",
  },
  {
    image: "/midias/home/midia/observatorio-sexta-extincao.webp",
    label: "Brasil Sustentável",
    title: "Observatório das aves e a 6ª extinção em massa",
    href: "https://www.youtube.com/watch?v=sTvSLOHZduE",
  },
  {
    image: "/midias/home/midia/paf-refloresta-agua-carbono.webp",
    imageAlt:
      "Crianças de boné e mochila sorrindo com os braços erguidos em uma trilha na mata",
    label: "Vídeo",
    title: "PAF (Re)Floresta Água e Carbono: Encontro pelas Florestas e a Água",
    href: "https://www.youtube.com/watch?v=dME4kmEfVdo",
  },
  {
    image: "/midias/home/midia/percepcoes-conservacao-aves.webp",
    imageAlt: "Vinheta de abertura do programa CNN Mais Verde",
    label: "Vídeo",
    title:
      "Percepções sobre conservação das aves e os desafios ambientais na Mata Atlântica",
    href: "https://www.youtube.com/watch?v=xe8_IRyp-rs",
  },
  {
    image: "/midias/home/midia/novo-website-acoes-pro-aves.webp",
    imageAlt:
      "Arte de divulgação do novo website do programa Ações Pró-Aves, com o site em monitor, tablet e celular",
    label: "ICMBio",
    title: "Novo website do programa Ações Pró-Aves",
    href: "https://www.gov.br/icmbio/pt-br/assuntos/noticias/ultimas-noticias/novo-website-acoes-pro-aves201d-reune-informacoes-para-a-conservacao-das-aves-da-mata-atlantica",
  },
  {
    image: "/midias/home/midia/colisao-aves-vidros-g1.webp",
    imageAlt:
      "Duas aves em voo, com as garras entrelaçadas, diante de uma vidraça",
    label: "G1 Terra da Gente",
    title: "Programa Ações Pró-Aves reúne informações sobre colisão de aves em vidros",
    href: "https://g1.globo.com/sp/campinas-regiao/terra-da-gente/noticia/2024/05/30/programa-de-conservacao-da-avifauna-reune-informacoes-sobre-colisao-de-aves-contra-vidros.ghtml",
  },
  {
    image: "/midias/home/midia/ave-migratoria-hemisferio-norte.webp",
    imageAlt:
      "Sabiá migratório de peito pintalgado pousado na mão de pesquisador do OAMa",
    label: "G1 Terra da Gente",
    title: "Captura de ave migratória do hemisfério norte surpreende equipe",
    href: "https://g1.globo.com/sp/campinas-regiao/terra-da-gente/noticia/2024/03/13/viajante-de-longa-distancia-conheca-a-ave-que-surpreendeu-pesquisadores-da-serra-da-mantiqueira.ghtml",
  },
  {
    image: "/midias/home/midia/historia-do-oama.webp",
    imageAlt:
      "Pesquisador do OAMa observando uma ave anilhada pousada em sua mão na mata",
    label: "G1 Sul do Rio",
    title: "História de criação do OAMa, nossos projetos e formas de apoio",
    href: "https://g1.globo.com/rj/sul-do-rio-costa-verde/noticia/2022/07/08/conheca-o-trabalho-de-amigos-que-criaram-um-observatorio-de-passaros-em-visconde-de-maua.ghtml",
  },
];

const items = await getMidiaItems();

const cards =
  items.length > 0
    ? items.map((item) => ({
        image: urlFor(item.image).width(480).height(474).fit("crop").auto("format").url(),
        label: item.label,
        title: item.title,
        href: item.link ?? undefined,
      }))
    : MIDIA;
---

{cards.length > 0 && (
<CardSection
  sectionTitle="OAMa na Mídia"
  subtitle="Acompanhe nosso trabalho"
  bg="#dfb553"
  id="midia-section"
  cards={cards}
/>
)}
