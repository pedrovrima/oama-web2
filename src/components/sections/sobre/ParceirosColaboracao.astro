---
interface Parceiro {
  nome: string;
  logo: string;
}

// Links removidos por decisão do usuário (2026-08-25): os itens desta seção
// não são mais clicáveis. URLs que estavam em uso, caso alguém queira voltar atrás:
//   CEMAVE / ICMBio-MMA — https://www.gov.br/icmbio
//   ICMBio / MMA — https://www.icmbio.gov.br
//   PANAves Mata Atlântica — https://panavesma.org.br
//   AVISTAR BRASIL — https://avistarbrasil.com.br
//   Klamath Bird Observatory — https://www.klamathbird.org
//   Pedra Selada — https://pedraselada.com.br
//   Alto Montana da Serra Fina — https://altomontana.com.br
//   Birds Atlantic — https://birdsatlantic.org
//   Secretaria Municipal de Turismo de Resende — https://resende.rj.gov.br
//   RiMa — https://rima.org.br
//   UERJ — https://www.uerj.br
//   Laboratório de Ornitologia — UFJF — https://www.ufjf.br
//   Laboratório de Evolução e Caracteres Complexos — USP — https://www.usp.br
// TODO: replace with Sanity query
// Sem logo local, o componente cai no fallback de TEXTO (ver template abaixo).
// Antes havia imagens de https://placehold.co — serviço externo de placeholder
// que aparecia no site como retângulo cinza escrito o nome. Não há logo dessas
// instituições na pasta de mídias do cliente.
const parceiros: Parceiro[] = [
  // O arquivo original trazia CEMAVE e ICMBio na MESMA imagem; foi cortado ao
  // meio e cada metade virou um logo (logo-cemave.webp / logo-icmbio.webp).
  { nome: "CEMAVE / ICMBio-MMA", logo: "/midias/sobre/logo-cemave.webp" },
  { nome: "ICMBio / MMA", logo: "/midias/sobre/logo-icmbio.webp" },
  { nome: "PANAves Mata Atlântica", logo: "/midias/sobre/logo-panaves.webp" },
  { nome: "AVISTAR BRASIL", logo: "/midias/sobre/logo-avistar.webp" },
  { nome: "Klamath Bird Observatory", logo: "/midias/sobre/logo-kbo.webp" },
  { nome: "Pedra Selada", logo: "/midias/sobre/logo-pedra-selada.webp" },
  { nome: "Alto Montana da Serra Fina", logo: "/midias/sobre/logo-alto-montana.webp" },
  { nome: "Birds Atlantic", logo: "/midias/sobre/logo-birds-atlantic.webp" },
  { nome: "Secretaria Municipal de Turismo de Resende", logo: "" },
  { nome: "RiMa", logo: "/midias/sobre/logo-rima.webp" },
  // Removidos por decisão do usuário (2026-08-25): de "Observatório Ecológico"
  // em diante — Simone Coimbra (é colaboradora, não parceira), ColaboraNóbrega,
  // Observatório de Aves do Butantan, Aves Noronha e Visconde de Mauá Apaixonante.
];

// TODO: replace with Sanity query
const colaboracaoCientifica: Parceiro[] = [
  { nome: "Laboratório de Biologia de Populações", logo: "/midias/sobre/logo-lab-bio-pop.webp" },
  // "Lab Ornitologia" saiu e o LiVeFlow entrou no lugar (decisão do usuário).
  // Logo exportado do Figma (nó 2291:178, "laboratório interações").
  { nome: "Laboratório LiVeFlow — USP", logo: "/midias/sobre/logo-liveflow.webp" },
  { nome: "LabOAc — Laboratório de Ornitologia e Bioacústica", logo: "/midias/sobre/logo-laboac.webp" },
  { nome: "LECAVE", logo: "/midias/sobre/logo-lecave.webp" },
  { nome: "UERJ", logo: "/midias/sobre/logo-uerj.webp" },
  { nome: "Laboratório de Ornitologia — UFJF", logo: "" },
  { nome: "Laboratório de Evolução e Caracteres Complexos — USP", logo: "" },
];
---

<section class="bg-white relative pt-16 pb-0 overflow-visible">

  <div class="max-w-4xl mx-auto px-6">

    <!-- PARCEIROS -->
    <h2 class="font-oswald font-bold text-[30px] text-oama-ink text-center uppercase tracking-wide mt-6">
      PARCEIROS
    </h2>
    <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-8 mt-10">
      {parceiros.map((p) => (
        <div class="group">
          {p.logo ? (
            <span class="flex h-20 w-[160px] items-center justify-center">
              <img
                src={p.logo}
                alt={p.nome}
                class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
                decoding="async"
                loading="lazy"
              />
            </span>
          ) : (
            <span class="flex h-20 w-[160px] items-center justify-center px-1 text-center font-montserrat text-[13px] font-bold leading-snug text-oama-ink transition-colors duration-200 group-hover:text-oama-yellow">
              {p.nome}
            </span>
          )}
        </div>
      ))}
    </div>

    <!-- COLABORAÇÃO CIENTÍFICA -->
    <h2 class="font-oswald font-bold text-[30px] text-oama-ink text-center uppercase tracking-wide mt-16">
      COLABORAÇÃO CIENTÍFICA
    </h2>
    <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-8 mt-10 mb-16">
      {colaboracaoCientifica.map((c) => (
        <div class="group">
          {c.logo ? (
            <span class="flex h-20 w-[160px] items-center justify-center">
              <img
                src={c.logo}
                alt={c.nome}
                class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
                decoding="async"
                loading="lazy"
              />
            </span>
          ) : (
            <span class="flex h-20 w-[160px] items-center justify-center px-1 text-center font-montserrat text-[13px] font-bold leading-snug text-oama-ink transition-colors duration-200 group-hover:text-oama-yellow">
              {c.nome}
            </span>
          )}
        </div>
      ))}
    </div>

  </div>


</section>
