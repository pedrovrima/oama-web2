---
interface Parceiro {
  nome: string;
  site: string;
  logo: string;
}

// TODO: replace with Sanity query
// Sem logo local, o componente cai no fallback de TEXTO (ver template abaixo).
// Antes havia imagens de https://placehold.co — serviço externo de placeholder
// que aparecia no site como retângulo cinza escrito o nome. Não há logo dessas
// instituições na pasta de mídias do cliente.
const parceiros: Parceiro[] = [
  // O arquivo original trazia CEMAVE e ICMBio na MESMA imagem; foi cortado ao
  // meio e cada metade virou um logo (logo-cemave.jpg / logo-icmbio.jpg).
  { nome: "CEMAVE / ICMBio-MMA", site: "https://www.gov.br/icmbio", logo: "/midias/sobre/logo-cemave.jpg" },
  { nome: "ICMBio / MMA", site: "https://www.icmbio.gov.br", logo: "/midias/sobre/logo-icmbio.jpg" },
  { nome: "PANAves Mata Atlântica", site: "https://panavesma.org.br", logo: "/midias/sobre/logo-panaves.jpg" },
  { nome: "AVISTAR BRASIL", site: "https://avistarbrasil.com.br", logo: "/midias/sobre/logo-avistar.png" },
  { nome: "Klamath Bird Observatory", site: "https://www.klamathbird.org", logo: "/midias/sobre/logo-kbo.jpg" },
  { nome: "Pedra Selada", site: "https://pedraselada.com.br", logo: "/midias/sobre/logo-pedra-selada.jpg" },
  { nome: "Alto Montana da Serra Fina", site: "https://altomontana.com.br", logo: "/midias/sobre/logo-alto-montana.jpg" },
  { nome: "Birds Atlantic", site: "https://birdsatlantic.org", logo: "/midias/sobre/logo-birds-atlantic.jpg" },
  { nome: "Secretaria Municipal de Turismo de Resende", site: "https://resende.rj.gov.br", logo: "" },
  { nome: "RiMa", site: "https://rima.org.br", logo: "/midias/sobre/logo-rima.jpg" },
  // Removidos por decisão do usuário (2026-08-25): de "Observatório Ecológico"
  // em diante — Simone Coimbra (é colaboradora, não parceira), ColaboraNóbrega,
  // Observatório de Aves do Butantan, Aves Noronha e Visconde de Mauá Apaixonante.
];

// TODO: replace with Sanity query
const colaboracaoCientifica: Parceiro[] = [
  { nome: "Laboratório de Biologia de Populações", site: "", logo: "/midias/sobre/logo-lab-bio-pop.jpg" },
  // "Lab Ornitologia" saiu e o LiVeFlow entrou no lugar (decisão do usuário).
  // PENDÊNCIA: o logo do LiVeFlow existe no Figma, mas o plugin não estava
  // conectado — por ora cai no fallback de texto.
  { nome: "Laboratório LiVeFlow — USP", site: "", logo: "" },
  { nome: "LabOAc — Laboratório de Ornitologia e Bioacústica", site: "", logo: "/midias/sobre/logo-laboac.jpg" },
  { nome: "LECAVE", site: "", logo: "/midias/sobre/logo-lecave.jpg" },
  { nome: "UERJ", site: "https://www.uerj.br", logo: "/midias/sobre/logo-uerj.jpg" },
  { nome: "Laboratório de Ornitologia — UFJF", site: "https://www.ufjf.br", logo: "" },
  { nome: "Laboratório de Evolução e Caracteres Complexos — USP", site: "https://www.usp.br", logo: "" },
];
---

<section class="bg-white relative pt-16 pb-0 overflow-visible">

  <div class="max-w-4xl mx-auto px-6">

    <!-- PARCEIROS -->
    <h2 class="font-oswald font-bold text-[30px] text-oama-ink text-center uppercase tracking-wide mt-6">
      PARCEIROS
    </h2>
    <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-8 mt-10">
      {parceiros.map((p) => {
        const hasLink = Boolean(p.site) && p.site !== "#";
        const Tag = hasLink ? "a" : "div";
        return (
        <Tag
          href={hasLink ? p.site : undefined}
          target={hasLink ? "_blank" : undefined}
          rel={hasLink ? "noopener noreferrer" : undefined}
          class="group"
        >
          {p.logo ? (
            <img
              src={p.logo}
              alt={p.nome}
              class="h-16 w-auto max-w-[130px] object-contain transition-transform duration-300 group-hover:scale-105"
            />
          ) : (
            <span class="flex h-16 max-w-[150px] items-center justify-center text-center font-montserrat text-[13px] font-bold leading-snug text-oama-ink transition-colors duration-200 group-hover:text-oama-yellow">
              {p.nome}
            </span>
          )}
        </Tag>
        );
      })}
    </div>

    <!-- COLABORAÇÃO CIENTÍFICA -->
    <h2 class="font-oswald font-bold text-[30px] text-oama-ink text-center uppercase tracking-wide mt-16">
      COLABORAÇÃO CIENTÍFICA
    </h2>
    <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-8 mt-10 mb-16">
      {colaboracaoCientifica.map((c) => {
        const hasLink = Boolean(c.site) && c.site !== "#";
        const Tag = hasLink ? "a" : "div";
        return (
        <Tag
          href={hasLink ? c.site : undefined}
          target={hasLink ? "_blank" : undefined}
          rel={hasLink ? "noopener noreferrer" : undefined}
          class="group"
        >
          {c.logo ? (
            <img
              src={c.logo}
              alt={c.nome}
              class="h-16 w-auto max-w-[140px] object-contain transition-transform duration-300 group-hover:scale-105"
            />
          ) : (
            <span class="flex h-16 max-w-[150px] items-center justify-center text-center font-montserrat text-[13px] font-bold leading-snug text-oama-ink transition-colors duration-200 group-hover:text-oama-yellow">
              {c.nome}
            </span>
          )}
        </Tag>
        );
      })}
    </div>

  </div>


</section>
