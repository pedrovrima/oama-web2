---
interface Colaborador {
  nome: string;
  cargo: string;
}

// TODO: replace with Sanity query
const colaboradores: Colaborador[] = [
  { nome: "Dirlene Ribeiro Martins", cargo: "Revisão de texto português" },
  { nome: "Ellen Campbell", cargo: "Revisão de texto inglês" },
  { nome: "Simone Coimbra", cargo: "Produção Use.OAMa" },
  { nome: "Karine Resende", cargo: "Assuntos gerais" },
];

interface TeamMember {
  nome: string;
  cargo: string;
  foto: string;
  email?: string;
  placeholder?: boolean;
}

// Dados recuperados de `pages/quem-somos/index.js` do site legado.
// Mantém-se a composição e os retratos locais definidos pelo Figma; cargos sem
// fonte no legado permanecem vazios para não inferir informação institucional.
const equipe: TeamMember[] = [ // preservado: a seção Equipe está desativada (ver abaixo)
  { nome: "Luiza Figueira", cargo: "Diretora Executiva", foto: "/midias/sobre/luiza-figueira.webp", email: "luiza@oama.eco.br" },
  { nome: "", cargo: "", foto: "", placeholder: true },
  { nome: "Pedro Martins", cargo: "Coordenador de dados", foto: "/midias/sobre/pedro-martins.webp" },
  { nome: "Affonso Souza", cargo: "Coordenador de projetos", foto: "/midias/sobre/affonso-souza.webp", email: "asouza@oama.eco.br" },
  { nome: "Otávio Rocha", cargo: "", foto: "/midias/sobre/otavio-rocha.webp" },
  { nome: "Danielle Santos", cargo: "Bióloga Colaboradora - Pesquisa e Monitoramento", foto: "/midias/sobre/danielle-santos.webp" },
  { nome: "Rafaella Vitti Ferneda", cargo: "Divulgação Científica", foto: "/midias/sobre/rafaela-vitti.webp" },
  { nome: "Andreza Oliveira", cargo: "Divulgação Científica", foto: "/midias/sobre/andreza-freitas.webp" },
  { nome: "Juliana Costa Villa", cargo: "", foto: "/midias/sobre/juliana-costa-villa.webp" },
  { nome: "Mariana Franciscão", cargo: "", foto: "/midias/sobre/mariana-franciscao.webp" },
  { nome: "Matheus Pinheiro", cargo: "", foto: "/midias/sobre/matheus-pinheiro.webp" },
  { nome: "Rachel Fidelis", cargo: "", foto: "/midias/sobre/rachel-fidelis.webp" },
