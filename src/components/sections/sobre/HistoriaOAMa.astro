---
import HistoriaTimeline from "../../ui/HistoriaTimeline.tsx";
import type { HistoriaItem } from "../../ui/HistoriaTimeline.tsx";

// TODO: replace with Sanity query
const historia: HistoriaItem[] = [
  {
    ano: 2017,
    titulo: "A IDEIA DE UM OBSERVATÓRIO DE AVES",
    texto: "Os primeiros passos do OAMa iniciaram-se quando nossos co-fundadores Luiza Figueira e Pedro Martins trabalharam como Pesquisadores Visitantes do Klamath Bird Observatory (KBO), no Oregon, EUA. Lá, foram inspirados pelo modelo de um observatório de aves: uma organização focada em pesquisa ornitológica, educação e conservação, que realiza monitoramento de longo prazo e sistemático de aves. A ideia de um observatório de aves da Mantiqueira foi apresentada por Pedro e Luiza na Conferência Internacional de Observatórios de Aves (IBOC), em Cape May, New Jersey, EUA. De volta ao Brasil, uniram-se a Raquel Justo, terceira co-fundadora, para elaborar a base de uma organização independente, sem fins lucrativos, conectando ciência, sociedade e conservação para preservar a biodiversidade.",
    foto: "/midias/sobre/historia-2017.jpg",
  },
  {
    ano: 2018,
    titulo: "OS PRIMEIROS PASSOS",
    texto: "Primeiros delineamentos e esforços amostrais do que viria a ser o Programa de Monitoramento Padronizado e de Longo Prazo de Avifauna.",
    foto: "/midias/sobre/historia-2018.jpg",
  },
  {
    ano: 2019,
    titulo: "A MATERIALIZAÇÃO DO SONHO",
    texto: "O OAMa foi registrado oficialmente como uma Organização do Terceiro Setor em 28 de agosto de 2019. No mesmo ano, realizou o Dia de campo: conhecendo as aves, em parceria com a ONG Silo — Arte e Latitude Rural e com apoio do edital CAMP do Instituto Serrapilheira; publicou o livreto Ornitologia pra todo dia; estabeleceu a Estação de Pesquisa (EP), base com casa, laboratório, escritório e sala de aula; e realizou o I Curso Prático de Análise de Muda e Classificação de Idade em Aves.",
    foto: "/midias/sobre/historia-2019.jpg",
  },
  {
    ano: 2020,
    titulo: "RECALCULANDO ROTAS",
    texto: "A pandemia trouxe desafios inéditos. O OAMa adaptou suas atividades, manteve o monitoramento essencial e investiu em comunicação digital para não perder o vínculo com a comunidade.",
    foto: undefined, // sem foto para 2020 no design (frame Celular_História 2275:277)
  },
  {
    ano: 2021,
    titulo: "COMUNICAÇÃO VIRTUAL DE CIÊNCIA E CONSERVAÇÃO",
    texto: "O OAMa expandiu sua presença digital com conteúdos científicos acessíveis, lives, cursos online e colaborações nacionais. A ciência chegou a mais pessoas do que nunca.",
    foto: "/midias/sobre/historia-2021.jpg",
  },
  {
    ano: 2022,
    titulo: "CAPACITAÇÃO ÉTICA E DE EXCELÊNCIA",
    texto: "Com o retorno ao campo, o foco foi na formação de novos cientistas e educadores, com cursos presenciais, expedições e parcerias com universidades brasileiras.",
    foto: "/midias/sobre/historia-2022.jpg",
  },
  {
    ano: 2023,
    titulo: "ECOTURISMO PARA RECONECTAR E CURAR",
    texto: "Em 2023 o OAMa lançou iniciativas de ecoturismo científico na Serra da Mantiqueira, conectando pessoas à natureza e gerando recursos para a conservação.",
    foto: "/midias/sobre/historia-2023.jpg",
  },
  {
    ano: 2024,
    titulo: "PESQUISA CIENTÍFICA PARA SUBSIDIAR NOVOS CAMINHOS",
    texto: "O OAMa consolidou parcerias científicas nacionais e internacionais, publicou resultados de longo prazo do monitoramento e ampliou sua atuação em políticas públicas para conservação das aves.",
    foto: "/midias/sobre/historia-2024.jpg",
  },
  {
    ano: 2025,
    titulo: "",
    texto: "A história continua...",
    foto: undefined,
  },
];
---

<section class="bg-[#5ba4d9] pb-0">
  <div class="max-w-3xl mx-auto px-6 pt-16 pb-16">
    <h2 class="font-oswald font-bold text-[30px] text-[#1a2e4a] text-center uppercase mb-12">
      A HISTÓRIA DO OAMA
    </h2>
    <HistoriaTimeline items={historia} client:load />
  </div>
</section>
