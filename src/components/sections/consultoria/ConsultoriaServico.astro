---
import WaveDark from "../WaveDark.astro";

interface Colors {
  yellow: string;
  blue: string;
  cream: string;
  dark: string;
}

interface Props {
  titulo: string;
  heroImg: string;
  heroAlt: string;
  /** object-position do hero, ex.: "center 30%" — para enquadrar a foto */
  heroPos?: string;
  servicos: string[];
  diferenciais: string[];
  publico: string[];
  icones: string[];
  colors: Colors;
}

const {
  titulo,
  heroImg,
  heroAlt,
  heroPos,
  servicos,
  diferenciais,
  publico,
  icones,
  colors,
} = Astro.props;

// SVG de cada ícone circular do bloco "Público potencial".
const iconPaths: Record<string, string> = {
  building:
    "M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01",
  shield: "M12 3l8 4v5c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4z",
  flask: "M9 3h6M10 3v6L4 19a2 2 0 001.7 3h12.6A2 2 0 0020 19L14 9V3M7 15h10",
  industry: "M3 21h18M5 21V10l5 3V10l5 3V8l6 3v10",
  tree: "M12 3l5 5h-3v4h3l-5 6-5-6h3V8H7l5-5zM12 18v3",
  book: "M12 6.5C10.5 5 8 4.5 5 5v13c3-.5 5.5 0 7 1.5M12 6.5C13.5 5 16 4.5 19 5v13c-3-.5-5.5 0-7 1.5M12 6.5v13",
  binoculars:
    "M7 4h3v3M14 4h3v3M6 7l-2 8a3 3 0 006 0l-1-8M13 7l-1 8a3 3 0 006 0l-2-8M6 7h4M14 7h4M10 11h4",
  hand: "M8 13V5a1.5 1.5 0 013 0v6m0-6a1.5 1.5 0 013 0v6m0-4a1.5 1.5 0 013 0v6a6 6 0 01-6 6h-1a6 6 0 01-5-3l-2.5-4a1.5 1.5 0 012.5-1.7L8 13",
  monitor: "M4 5h16v11H4zM9 20h6M12 16v4M8 10l2 2 3-4",
};
---

<main class="font-montserrat">
  {/* HERO (frame: foto de altura contida, SEM título sobreposto) */}
  <section class="relative h-[300px] w-full overflow-hidden md:h-[620px]">
    <img
      src={heroImg}
      alt={heroAlt}
      class="absolute inset-0 h-full w-full object-cover"
      style={heroPos ? `object-position:${heroPos};` : undefined}
      loading="eager"
    />
  </section>

  {/* Faixa AZUL: título + Serviços | Diferenciais do OAMa (2 colunas) */}
  <section class="w-full scroll-mt-24" style={`background:${colors.blue};`}>
    <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
      {/* Título centralizado na faixa, como no frame */}
      <h1
        class="mb-12 text-center font-oswald text-[30px] font-bold uppercase leading-[36px] text-white md:text-[44px] md:leading-[50px]"
      >
        {titulo}
      </h1>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
        <div>
          <h2
            class="mb-5 text-center font-montserrat text-[18px] font-semibold leading-[25px] text-white md:text-left"
          >
            Serviços
          </h2>
          <ul
            class="list-disc space-y-1 pl-5 font-montserrat text-[16px] leading-[24px] text-oama-ink marker:text-oama-ink"
          >
            {servicos.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        {/* No mobile os Diferenciais migram para a faixa amarela (ver abaixo);
            no desktop seguem como 2ª coluna da faixa azul, como no Figma. */}
        <div class="hidden md:block">
          <h2
            class="mb-5 font-montserrat text-[18px] font-semibold leading-[25px] text-white"
          >
            Diferenciais do OAMa
          </h2>
          <ul
            class="list-disc space-y-1 pl-5 font-montserrat text-[16px] leading-[24px] text-oama-ink marker:text-oama-ink"
          >
            {diferenciais.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Onda azul → creme → escuro → amarelo */}
  <WaveDark
    topColor={colors.blue}
    bottomColor={colors.yellow}
    path1Color={colors.cream}
    path2Color={colors.dark}
  />

  {/* Faixa AMARELA: no mobile carrega os Diferenciais do OAMa;
      no desktop continua sendo apenas uma faixa curta de transição. */}
  <section class="w-full" style={`background:${colors.yellow};`}>
    <div class="hidden h-6 md:block md:h-10"></div>
    <div class="mx-auto max-w-5xl px-6 pb-10 pt-8 md:hidden">
      <h2
        class="mb-5 text-center font-montserrat text-[18px] font-semibold leading-[25px] text-white"
      >
        Diferenciais do OAMa
      </h2>
      <ul
        class="list-disc space-y-1 pl-5 font-montserrat text-[16px] leading-[24px] text-oama-ink marker:text-oama-ink"
      >
        {diferenciais.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
  <WaveDark
    topColor={colors.yellow}
    bottomColor="white"
    path1Color={colors.cream}
    path2Color={colors.dark}
  />

  {/* Faixa BRANCA: Público potencial (lista + cluster de ícones) */}
  <section id="publico-potencial" class="w-full scroll-mt-24 bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2">
        <div>
          <h2
            class="mb-5 font-montserrat text-[18px] font-semibold leading-[25px] text-oama-ink"
          >
            Público potencial
          </h2>
          <ul
            class="list-disc space-y-1 pl-5 font-montserrat text-[16px] leading-[24px] text-oama-ink marker:text-oama-ink"
          >
            {publico.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        {/* Cluster de ícones circulares azuis */}
        <div class="flex justify-center md:justify-end">
          <div class="grid w-[220px] grid-cols-2 gap-4">
            {
              icones.map((ic, i) => (
                <span
                  class={`inline-flex h-[84px] w-[84px] items-center justify-center rounded-full text-white shadow-md ${
                    i % 2 === 1 ? "translate-y-6" : ""
                  }`}
                  style={`background:${colors.blue};`}
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-9 w-9"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={iconPaths[ic] ?? iconPaths.building} />
                  </svg>
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Onda branco → azul, entrando na faixa do formulário */}
  <WaveDark
    topColor="white"
    bottomColor={colors.blue}
    path1Color={colors.yellow}
    path2Color={colors.dark}
  />

  {/* Faixa AZUL: FALE CONOSCO (formulário que monta um mailto) */}
  <section
    id="fale-conosco"
    class="w-full scroll-mt-24"
    style={`background:${colors.blue};`}
  >
    <div class="mx-auto max-w-5xl px-6 py-14 md:py-20">
      <h2
        class="font-oswald text-[28px] font-bold uppercase leading-[34px] text-white md:text-[40px] md:leading-[46px]"
      >
        Fale Conosco
      </h2>
      <p
        class="mt-4 max-w-2xl font-montserrat text-[16px] font-semibold leading-[24px] text-white"
      >
        Busca serviços pautados na ciência e na conservação da biodiversidade?
        Preencha o formulário ou envie um e-mail para <a
          class="underline underline-offset-4"
          href="mailto:contato@oama.eco.br">contato@oama.eco.br</a
        > e solicite um orçamento personalizado.
      </p>

      <form class="mt-8 max-w-2xl space-y-3" aria-label="Fale conosco" data-servico-form>
        <label class="sr-only" for="servico-nome">Nome Completo</label>
        <input
          id="servico-nome"
          type="text"
          name="nome"
          placeholder="Nome Completo"
          autocomplete="name"
          required
          class="w-full rounded-full px-5 py-3 font-montserrat text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none focus:ring-2 focus:ring-white"
          style={`background:${colors.yellow};`}
        />
        <label class="sr-only" for="servico-email">E-mail</label>
        <input
          id="servico-email"
          type="email"
          name="email"
          placeholder="E-mail"
          autocomplete="email"
          required
          class="w-full rounded-full px-5 py-3 font-montserrat text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none focus:ring-2 focus:ring-white"
          style={`background:${colors.yellow};`}
        />
        <label class="sr-only" for="servico-telefone">Telefone com DDD</label>
        <input
          id="servico-telefone"
          type="tel"
          name="telefone"
          placeholder="Telefone com DDD"
          autocomplete="tel"
          class="w-full rounded-full px-5 py-3 font-montserrat text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none focus:ring-2 focus:ring-white"
          style={`background:${colors.yellow};`}
        />
        <label class="sr-only" for="servico-assunto">Assunto</label>
        <input
          id="servico-assunto"
          type="text"
          name="assunto"
          placeholder="Assunto"
          class="w-full rounded-full px-5 py-3 font-montserrat text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none focus:ring-2 focus:ring-white"
          style={`background:${colors.yellow};`}
        />
        <label class="sr-only" for="servico-mensagem">Escreva sua mensagem</label>
        <textarea
          id="servico-mensagem"
          name="mensagem"
          placeholder="Escreva sua mensagem"
          rows="6"
          required
          class="w-full rounded-[24px] px-5 py-4 font-montserrat text-[15px] text-oama-ink placeholder:text-oama-ink/70 focus:outline-none focus:ring-2 focus:ring-white"
          style={`background:${colors.yellow};`}></textarea>
        <div class="pt-1">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-full bg-white px-10 py-3 font-montserrat text-[15px] font-semibold transition hover:brightness-95"
            style={`color:${colors.blue};`}
          >
            Enviar
          </button>
        </div>
        <p
          class="text-[14px] leading-5 text-white"
          data-servico-status
          hidden
          aria-live="polite"
        >
        </p>
        <a
          class="inline-flex text-[14px] font-semibold text-white underline underline-offset-4"
          data-servico-email-link
          href="mailto:contato@oama.eco.br"
          hidden
        >
          Abrir o e-mail novamente
        </a>
      </form>
    </div>
  </section>
</main>

<script>
  // Mesmo comportamento do formulário do hub /consultoria: não há back-end,
  // o envio monta um mailto: e abre o cliente de e-mail do visitante.
  const form = document.querySelector<HTMLFormElement>("[data-servico-form]");
  const status = form?.querySelector<HTMLElement>("[data-servico-status]");
  const emailLink = form?.querySelector<HTMLAnchorElement>(
    "[data-servico-email-link]",
  );

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const valor = (campo: string) => String(data.get(campo) ?? "").trim();
    const assunto = valor("assunto") || "Contato pelo site do OAMa";
    const corpo = [
      "Olá, equipe OAMa!",
      "",
      `Nome: ${valor("nome")}`,
      `E-mail: ${valor("email")}`,
      `Telefone: ${valor("telefone") || "Não informado"}`,
      `Assunto: ${assunto}`,
      "",
      "Mensagem:",
      valor("mensagem"),
    ].join("\n");
    const mailto = `mailto:contato@oama.eco.br?subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(corpo)}`;

    if (emailLink && status) {
      emailLink.href = mailto;
      emailLink.hidden = false;
      status.textContent =
        "Seu aplicativo de e-mail será aberto com a mensagem preenchida. Revise os dados e confirme o envio por lá. Se nada acontecer, use o link abaixo.";
      status.hidden = false;
    }

    window.location.href = mailto;
  });
</script>
