---
import { getAgendaItems, urlFor } from "../../utils/sanity";
import CardSection from "./CardSection.astro";

// Agenda de 2026 informada pelo OAMa. Fica no código porque o Sanity ainda não
// tem itens cadastrados; assim que tiver, os dados de lá têm prioridade.
// Todos os eventos já têm foto enviada pelo OAMa.
const AGENDA_2026 = [
  {
    image: "/midias/home/agenda/festival-aves-natureza-agulhas-negras-2026.webp",
    label: "28 a 30 de agosto",
    title: "IV Festival de Aves e Natureza das Agulhas Negras",
  },
  {
    image: "/midias/home/agenda/fundraising-field-trip-2026.webp",
    label: "2 a 12 de setembro",
    title: "FUNdraising Field Trip 2026",
  },
  {
    image: "/midias/home/agenda/avistar-rio-2026.webp",
    label: "4 a 7 de setembro",
    title: "Avistar Rio 2026",
  },
  {
    image: "/midias/home/agenda/curso-pratico-passeriformes.webp",
    label: "12 a 17 de setembro",
    title:
      "Curso prático de anilhamento, análise de mudas e classificação de idades em aves tropicais (foco em passeriformes)",
  },
  {
    image: "/midias/home/agenda/congresso-brasileiro-ornitologia-2026.webp",
    imageAlt:
      "Equipe do OAMa reunida diante do painel do Congresso Brasileiro de Ornitologia",
    label: "20 a 24 de setembro",
    title: "XXX Congresso Brasileiro de Ornitologia",
  },
  {
    image: "/midias/home/agenda/ilhabela-bird-week-2026.webp",
    imageAlt: "Grupo de estudantes observando aves com binóculos",
    label: "21 a 27 de setembro",
    title: "IlhaBela Bird Week 2026",
  },
  {
    image: "/midias/home/agenda/curso-pratico-beija-flores.webp",
    label: "24 a 29 de outubro",
    title:
      "Curso prático de anilhamento, análise de mudas e classificação de idades em aves tropicais (foco em beija-flores)",
  },
];

const items = await getAgendaItems();

const cards =
  items.length > 0
    ? items.map((item) => ({
        image: urlFor(item.image).width(480).height(474).fit("crop").auto("format").url(),
        label: item.label,
        title: item.title,
        href: item.link ?? undefined,
      }))
    : AGENDA_2026;
---

{cards.length > 0 && (
<CardSection
  sectionTitle="Agenda 2026"
  bg="#dfb553"
  id="agenda-section"
  cards={cards}
/>
)}
