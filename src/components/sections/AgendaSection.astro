---
import { getAgendaItems, urlFor } from "../../utils/sanity";
import CardSection from "./CardSection.astro";

// Sem fallback fabricado: a agenda vem do Sanity. O que havia aqui eram eventos
// de exemplo com fotos do Unsplash e href="#" — anunciar evento que não existe
// é pior que não ter seção. Enquanto não houver itens reais, não renderiza.

const items = await getAgendaItems();

const cards = items.map((item) => ({
  image: urlFor(item.image).width(480).height(474).fit("crop").auto("format").url(),
  label: item.label,
  title: item.title,
  href: item.link ?? undefined,
}));
---

{cards.length > 0 && (
<CardSection
  sectionTitle="Agenda 2025"
  bg="#dfb553"
  id="agenda-section"
  cards={cards}
/>
)}
